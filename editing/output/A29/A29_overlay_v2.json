  }
 ],
 "name_card": {
  "start": 11.18,
  "role": "shiun XSのスナップ担当",
  "name": "塚田",
  "honorific": "さん"
 },
 "subs": [
  {
   "start": 0.0,
   "end": 1.22,
   "text": "どうもわむうです"
  },
  {
   "start": 1.22,
   "end": 5.32,
   "text": "今回はですね低身長男性用のブランド"
  },
  {
   "start": 5.32,
   "end": 7.24,
   "text": "shiunっていうのをやっているんですが"
  },
  {
   "start": 7.24,
   "end": 11.18,
   "text": "XSサイズのですねスナップを担当してくださっている"
  },
  {
   "start": 11.18,
   "end": 13.0,
   "text": "塚田さんにね来ていただきました"
  },
  {
   "start": 13.0,
   "end": 14.14,
   "text": "ありがとうございます"
  },
  {
   "start": 14.14,
   "end": 16.0,
   "text": "ありがとうございます"
  },
  {
   "start": 16.0,
   "end": 17.72,
   "text": "僕はshiunっていうブランドで"
  },
  {
   "start": 17.72,
   "end": 19.8,
   "text": "普段Sサイズを着てるんですよ"
  },
  {
   "start": 19.8,
   "end": 22.56,
   "text": "Sサイズ素晴らしいよーとか言ってるんですけども"
  },
  {
   "start": 22.56,
   "end": 25.28,
   "text": "XSから展開してるんですけども"
  },
  {
   "start": 25.28,
   "end": 29.06,
   "text": "XSって150cm程の方に向けたサイズではあるんですが"
  },
  {
   "start": 29.06,
   "end": 33.46,
   "text": "フォロワーさんからはですねshiunのXSって他にはないし"
  },
  {
   "start": 33.46,
   "end": 36.38,
   "text": "素晴らしいからどんどん作ってほしいし"
  },
  {
   "start": 36.38,
   "end": 37.86,
   "text": "めちゃくちゃいいみたいな感想を"
  },
  {
   "start": 37.86,
   "end": 40.08,
   "text": "ほんまにたくさんもらうんですよ嬉しいことに"
  },
  {
   "start": 40.08,
   "end": 45.2,
   "text": "ただ僕発信でshiunのXSこんだけ素晴らしいんだよっていうのを"
  },
  {
   "start": 45.2,
   "end": 48.72,
   "text": "そういえばちゃんと言ったことってないなと思いまして"
  },
  {
   "start": 48.72,
   "end": 52.6,
   "text": "その動画を撮ろうと思ったんですよ"
  },
  {
   "start": 52.6,
   "end": 56.54,
   "text": "僕が言っても説得力ないなってことで"
  },
  {
   "start": 56.54,
   "end": 59.04,
   "text": "周りを見たらつかにーがいました"
  },
  {
   "start": 59.04,
   "end": 60.9,
   "text": "どうもありがとうございます"
  },
  {
   "start": 60.9,
   "end": 61.7,
   "text": "塚田さんですね"
  },
  {
   "start": 61.7,
   "end": 65.06,
   "text": "塚田さんってガチでshiun買ってくれてるじゃないですか"
  },
  {
   "start": 65.06,
   "end": 67.34,
   "text": "ガチで買ってます"
  },
  {
   "start": 67.34,
   "end": 69.0,
   "text": "ガッチガチ"
  },
  {
   "start": 69.0,
   "end": 71.92,
   "text": "ほんまにガチガチに買ってくれてるんですよ"
  },
  {
   "start": 71.92,
   "end": 75.78,
   "text": "いつもXSが多いたまにSも買ったりします"
  },
  {
   "start": 75.78,
   "end": 77.74,
   "text": "ウエストがちょっと太いんで"
  },
  {
   "start": 77.74,
   "end": 82.12,
   "text": "そんなことないですけどねガリガリですよ"
  },
  {
   "start": 82.56,
   "end": 86.8,
   "text": "しゃあないですよ30歳超えたら太るんでね人間は"
  },
  {
   "start": 86.8,
   "end": 90.78,
   "text": "しゃあないですけどもパンツのウエストによっては良いですけども"
  },
  {
   "start": 90.78,
   "end": 92.78,
   "text": "XSも多めに買ってくれるか"
  },
  {
   "start": 92.78,
   "end": 95.02,
   "text": "ありがとうございます"
  },
  {
   "start": 95.02,
   "end": 97.74,
   "text": "必須のガチガチのshiunと"
  },
  {
   "start": 97.74,
   "end": 99.82,
   "text": "基本的なXSサイズを着てくださっている"
  },
  {
   "start": 99.82,
   "end": 102.3,
   "text": "ユーザーの塚田さんにですね"
  },
  {
   "start": 102.3,
   "end": 107.92,
   "text": "shiunを買い続ける理由を聞いていこうかなと思います"
  },
  {
   "start": 107.92,
   "end": 108.74,
   "text": "そのテーマにしたのは"
  },
  {
   "start": 108.74,
   "end": 113.1,
   "text": "僕が買い続ける理由を言ってくれませんかって言ったんじゃなくて"
  },
  {
   "start": 113.1,
   "end": 116.86,
   "text": "動画に出演してくれませんかってお願いしたところ"
  },
  {
   "start": 116.86,
   "end": 121.82,
   "text": "買い続ける理由みたいな膨大な台本を書いてくださって"
  },
  {
   "start": 121.82,
   "end": 125.58,
   "text": "すごい全部言うんすね裏側も"
  },
  {
   "start": 125.58,
   "end": 130.1,
   "text": "言わないと僕がお願いしたみたいになったら"
  },
  {
   "start": 130.5,
   "end": 133.04,
   "text": "だから膨大な台本を考えてくれて"
  },
  {
   "start": 133.04,
   "end": 136.44,
   "text": "それがめっちゃ伝わってきてめっちゃ嬉しかったですまず"
  },
  {
   "start": 136.44,
   "end": 138.84,
   "text": "まず感謝の量がすごいんでこっち"
  },
  {
   "start": 138.84,
   "end": 141.8,
   "text": "こっちのことっすよ"
  },
  {
   "start": 141.82,
   "end": 143.14,
   "text": "今だと思ってすいませんありがとうございます"
  },
  {
   "start": 143.14,
   "end": 145.54,
   "text": "ここぞとばかりにすいませんね"
  },
  {
   "start": 145.54,
   "end": 147.78,
   "text": "買い続ける理由を聞いていこうと思いますけど"
  },
  {
   "start": 147.78,
   "end": 148.38,
   "text": "お願いします"
  },
  {
   "start": 148.38,
   "end": 153.82,
   "text": "早速じゃあ1個目のここに台本があります買い続ける理由"
  },
  {
   "start": 153.82,
   "end": 154.62,
   "text": "全部言う"
  },
  {
   "start": 154.62,
   "end": 159.04,
   "text": "いくつかね買い続ける理由があるんですけど"
  },
  {
   "start": 159.04,
   "end": 165.01,
   "text": "悩みですよねいわゆる服の悩みがいくつかあって"
  },
  {
   "start": 165.01,
   "end": 170.37,
   "text": "まず一つは大前提好きなんですよ服を大前提好きで"
  },
  {
   "start": 170.37,
   "end": 171.95,
   "text": "服楽しいです"
  },
  {
   "start": 171.95,
   "end": 178.93,
   "text": "休みの日電車乗って渋谷新宿の商業施設あるじゃないですか"
  },
  {
   "start": 178.93,
   "end": 182.39,
   "text": "いっぱい回っていっぱい試着して"
  },
  {
   "start": 182.39,
   "end": 185.33,
   "text": "その日何も買えずに帰るみたいな"
  },
  {
   "start": 185.33,
   "end": 192.83,
   "text": "全部サイズ合わないな丈も長くて微妙だなみたいな"
  },
  {
   "start": 192.83,
   "end": 196.29,
   "text": "店員さんもそれはね大きめで着る服なんで"
  },
  {
   "start": 196.29,
   "end": 198.25,
   "text": "フォローしてくれるんですよね"
  },
  {
   "start": 198.25,
   "end": 201.57,
   "text": "「いやそうでもないいい感じですけどね」みたいな"
  },
  {
   "start": 201.57,
   "end": 205.09,
   "text": "でも内心大きいだろ"
  },
  {
   "start": 205.09,
   "end": 211.11,
   "text": "自分の中で納得できないんで買わずっていうのが結構あって"
  },
  {
   "start": 211.11,
   "end": 212.19,
   "text": "ZOZOでいっぱい探して"
  },
  {
   "start": 212.19,
   "end": 217.01,
   "text": "なるべく着れるやつこれかなみたいな探すみたいなもん"
  },
  {
   "start": 217.01,
   "end": 219.77,
   "text": "着く隙だらけによりしんどくて"
  },
  {
   "start": 219.77,
   "end": 220.95,
   "text": "悔しいっすよね"
  },
  {
   "start": 220.95,
   "end": 222.47,
   "text": "悔しかったんですよねもどかしい"
  },
  {
   "start": 222.47,
   "end": 224.85,
   "text": "そもそもそりゃそうだなって思うんですよ"
  },
  {
   "start": 224.85,
   "end": 231.09,
   "text": "街中見て大人じゃ俺の身長どんだけいるよっていう"
  },
  {
   "start": 231.31,
   "end": 236.15,
   "text": "いわゆる服って平均身長とかあの辺をターゲットにしないと"
  },
  {
   "start": 236.15,
   "end": 237.29,
   "text": "会社もやっていけないんで"
  },
  {
   "start": 237.29,
   "end": 240.53,
   "text": "そりゃ低身長を無視するよなっていうサイジングですよね"
  },
  {
   "start": 240.53,
   "end": 244.01,
   "text": "そこら辺は自分のせいだなって思いながら"
  },
  {
   "start": 244.01,
   "end": 248.53,
   "text": "自責自分が悪いっていうのがあったんで"
  },
  {
   "start": 248.53,
   "end": 251.49,
   "text": "ほぼ諦めてちょっと大きめ着たり"
  },
  {
   "start": 251.49,
   "end": 254.13,
   "text": "ちょっと妥協しながら着てたんですよね"
  },
  {
   "start": 254.13,
   "end": 257.05,
   "text": "もう本当にそんな日々が安いって"
  },
  {
   "start": 257.05,
   "end": 259.73,
   "text": "古着買ったり色々買い続けたんですけど"
  },
  {
   "start": 259.73,
   "end": 263.05,
   "text": "そこからある時WIMに一回出会って"
  },
  {
   "start": 263.05,
   "end": 267.19,
   "text": "WIMもねちょっと大きかったりするんですよ"
  },
  {
   "start": 267.19,
   "end": 271.03,
   "text": "いわゆる最初の頃のWIMってXSもそんななくて"
  },
  {
   "start": 271.03,
   "end": 274.11,
   "text": "でもその時はクロップ丈が履いてたんですよね"
  },
  {
   "start": 274.11,
   "end": 275.93,
   "text": "パンツがクロップ丈履いてて"
  },
  {
   "start": 275.93,
   "end": 281.33,
   "text": "それをフルレングスで履いて書くみたいなその時期があって"
  },
  {
   "start": 281.33,
   "end": 284.13,
   "text": "ギリ悩み解決されたなとか"
  },
  {
   "start": 284.13,
   "end": 287.53,
   "text": "なんとなく自分の中で落とし所見つけて着たりしてたんですけど"
  },
  {
   "start": 287.53,
   "end": 296.38,
   "text": "そんな中shiunというブランドが爆誕"
  },
  {
   "start": 296.38,
   "end": 298.5,
   "text": "5年ぐらい前に始まって"
  },
  {
   "start": 298.5,
   "end": 301.6,
   "text": "最初は僕ね知らなかったんですよ"
  },
  {
   "start": 301.6,
   "end": 304.62,
   "text": "そもそも初期は知らなかったんですよ"
  },
  {
   "start": 304.62,
   "end": 307.14,
   "text": "やってないですよ"
  },
  {
   "start": 307.14,
   "end": 308.58,
   "text": "ここに入手させて"
  },
  {
   "start": 308.58,
   "end": 311.58,
   "text": "どうやらわむうさんがブランドをやってる"
  },
  {
   "start": 311.58,
   "end": 312.46,
   "text": "やらせていただいてます"
  },
  {
   "start": 312.46,
   "end": 316.58,
   "text": "最初ねぶっちゃけて言うとわむうさん見てなかったんですよ"
  },
  {
   "start": 316.58,
   "end": 322.48,
   "text": "最初だけ見てユニクロ紹介テンション高いなーと思って"
  },
  {
   "start": 323.44,
   "end": 325.46,
   "text": "ぶち上げないとやってられへんから"
  },
  {
   "start": 325.46,
   "end": 329.72,
   "text": "改めて見てかっこよくねってなって"
  },
  {
   "start": 329.72,
   "end": 331.64,
   "text": "でshiunを着てみたらすっごいかっこよくて"
  },
  {
   "start": 331.64,
   "end": 337.89,
   "text": "そっから買い続けてるって感じなんですよね"
  },
  {
   "start": 340.05,
   "end": 343.73,
   "text": "単純にかっこいいですお世辞とかじゃなくて"
  },
  {
   "start": 343.73,
   "end": 349.19,
   "text": "安いしかっこいいしトレンドもされてるし"
  },
  {
   "start": 350.11,
   "end": 354.07,
   "text": "僕の立場だから見れるじゃないですか実際に"
  },
  {
   "start": 354.07,
   "end": 358.41,
   "text": "試着会とかもあると思うんですけど最近は全部アイテム見れて"
  },
  {
   "start": 358.41,
   "end": 362.39,
   "text": "なんならげんじさんの超高級アイテムを見れてる中で"
  },
  {
   "start": 362.39,
   "end": 364.77,
   "text": "ちょっとした目も養っていくじゃないですか"
  },
  {
   "start": 364.77,
   "end": 370.79,
   "text": "中でもかっこいいなと思える何の妥協もなく"
  },
  {
   "start": 370.79,
   "end": 376.77,
   "text": "shiunを買っているという現状に本当に大感謝"
  },
  {
   "start": 378.72,
   "end": 382.94,
   "text": "つかださんはそもそもチームshiunではないんですよね"
  },
  {
   "start": 382.94,
   "end": 386.26,
   "text": "一応スナップとかをやっていただいてはいますが"
  },
  {
   "start": 386.26,
   "end": 388.56,
   "text": "がっつり一緒に仕事をしているわけじゃなくて"
  },
  {
   "start": 388.56,
   "end": 391.54,
   "text": "この動画を撮影した上で"
  },
  {
   "start": 391.54,
   "end": 394.08,
   "text": "shiunの売上が増えた僕のフォロワーが増えたとて"
  },
  {
   "start": 394.08,
   "end": 396.82,
   "text": "つかださんに直接的なメリットは別にないんですよ"
  },
  {
   "start": 396.82,
   "end": 397.58,
   "text": "何もない"
  },
  {
   "start": 397.58,
   "end": 400.04,
   "text": "なんならカミングスみたいな感じで"
  },
  {
   "start": 400.04,
   "end": 402.06,
   "text": "たまにインスタとかで投稿するんですけど"
  },
  {
   "start": 402.06,
   "end": 405.46,
   "text": "そうしたら自分が買えなくなっちゃう"
  },
  {
   "start": 405.46,
   "end": 407.94,
   "text": "今はVIP制度があると思うんですけど"
  },
  {
   "start": 407.94,
   "end": 411.4,
   "text": "昔なくて買いたいやつ買えなかったんだけどみたいな"
  },
  {
   "start": 411.4,
   "end": 413.08,
   "text": "確かに僕でさえそれ終わるんで"
  },
  {
   "start": 413.08,
   "end": 418.82,
   "text": "ケースがあってあれなんか首絞めてるじゃんみたいな自分の"
  },
  {
   "start": 418.82,
   "end": 421.2,
   "text": "それは嬉しいですね僕からしたらめっちゃ嬉しい"
  },
  {
   "start": 421.2,
   "end": 422.84,
   "text": "みんなに届けたいって思いと"
  },
  {
   "start": 422.84,
   "end": 426.64,
   "text": "買いたいって思いがバチバチになってるんですけど"
  },
  {
   "start": 426.64,
   "end": 428.7,
   "text": "やっぱり直接的なメリットがなくても"
  },
  {
   "start": 428.7,
   "end": 431.18,
   "text": "こうやって動画出演してくれて"
  },
  {
   "start": 431.18,
   "end": 433.36,
   "text": "スナップも協力してくれて"
  },
  {
   "start": 433.36,
   "end": 435.2,
   "text": "かつめっちゃ褒めてくれてみたいな"
  },
  {
   "start": 435.2,
   "end": 436.4,
   "text": "かつ買ってくれてみたいな"
  },
  {
   "start": 436.4,
   "end": 438.28,
   "text": "ほんまに嬉しいです本当にいつもありがとうございます"
  },
  {
   "start": 438.28,
   "end": 441.28,
   "text": "いやもう本当にXSの希望の星ですから"
  },
  {
   "start": 441.28,
   "end": 442.44,
   "text": "XSの希望の星"
  },
  {
   "start": 442.44,
   "end": 446.46,
   "text": "XSやってるブランドも少ないですもんねそもそもが"
  },
  {
   "start": 446.46,
   "end": 450.84,
   "text": "やってたとしてもね他社を見てないからこそ言っちゃうんですけど"
  },
  {
   "start": 450.84,
   "end": 455.34,
   "text": "かっこいいと思えないんですよねそのXSブランドを"
  },
  {
   "start": 455.34,
   "end": 459.76,
   "text": "XSだけを主張してる感"
  },
  {
   "start": 459.76,
   "end": 462.26,
   "text": "ちっちゃいだけやんという"
  },
  {
   "start": 462.26,
   "end": 467.5,
   "text": "服としての魅力を感じきれてない"
  },
  {
   "start": 467.52,
   "end": 471.76,
   "text": "僕も言うてshiunも今後もっとかっこよくなっていくし"
  },
  {
   "start": 471.76,
   "end": 473.5,
   "text": "5年前の最初よりかは"
  },
  {
   "start": 473.5,
   "end": 475.98,
   "text": "今もめちゃくちゃかっこよくなってると思うんですけど"
  },
  {
   "start": 475.98,
   "end": 477.48,
   "text": "めっちゃむずいんですよ"
  },
  {
   "start": 477.48,
   "end": 480.58,
   "text": "低身長男性に向けたちっちゃいサイズの服って"
  },
  {
   "start": 480.58,
   "end": 483.86,
   "text": "ただ単に大きい服をギュッてすればいいわけじゃなくて"
  },
  {
   "start": 483.86,
   "end": 486.22,
   "text": "ギュッてしても肩幅とか言うて"
  },
  {
   "start": 486.22,
   "end": 489.1,
   "text": "高身長と僕たちってそんなに変わらないんで"
  },
  {
   "start": 489.1,
   "end": 491.3,
   "text": "その辺ですごい苦戦したりはするんで"
  },
  {
   "start": 491.3,
   "end": 493.58,
   "text": "ただ他がどうとかが分かんないですけど"
  },
  {
   "start": 493.58,
   "end": 498.2,
   "text": "競合リサーチした結果割とちっちゃくしてるだけのところが多いんで"
  },
  {
   "start": 498.2,
   "end": 499.48,
   "text": "っていう話ですよね多分"
  },
  {
   "start": 499.48,
   "end": 502.6,
   "text": "本当そうで他社ブランド履くと本当にね"
  },
  {
   "start": 502.6,
   "end": 505.08,
   "text": "デニムパンツ丈は良くても"
  },
  {
   "start": 505.08,
   "end": 508.98,
   "text": "ウエストがきつすぎてもう締まんないんですよね"
  },
  {
   "start": 508.98,
   "end": 511.48,
   "text": "ウエストもギューってしてるっていう"
  },
  {
   "start": 511.48,
   "end": 513.84,
   "text": "shiunはね履けちゃう"
  },
  {
   "start": 513.84,
   "end": 516.22,
   "text": "僕がね結構言うんですよ結構きついですねとか"
  },
  {
   "start": 516.22,
   "end": 517.18,
   "text": "言ってくれますねいつも"
  },
  {
   "start": 517.18,
   "end": 518.86,
   "text": "ゴムがいいですねとか"
  },
  {
   "start": 518.86,
   "end": 524.4,
   "text": "それを加味してか分かんないけど反映してくださってて"
  },
  {
   "start": 524.5,
   "end": 526.48,
   "text": "すごい履きやすいんですよ"
  },
  {
   "start": 526.48,
   "end": 528.64,
   "text": "つかださんのそういった声もあり"
  },
  {
   "start": 528.64,
   "end": 531.06,
   "text": "フォロワーさんからもめっちゃ多くて"
  },
  {
   "start": 531.06,
   "end": 534.36,
   "text": "細すぎるとか細すぎるもちょうど同じくて"
  },
  {
   "start": 534.36,
   "end": 538.72,
   "text": "ってことはゴムでその範囲をカバーできたらいいなと思って"
  },
  {
   "start": 538.72,
   "end": 541.32,
   "text": "後ろゴムにしたりしましたね"
  },
  {
   "start": 541.32,
   "end": 543.94,
   "text": "本当に神"
  },
  {
   "start": 543.94,
   "end": 547.86,
   "text": "今後とも貴重な意見お待ちしてます"
  },
  {
   "start": 547.86,
   "end": 551.02,
   "text": "じゃあ他社でウエストがちょうどいいものを買うと"
  },
  {
   "start": 551.02,
   "end": 555.94,
   "text": "パンツで言うと裾が長くなるパンツだけが長くなる"
  },
  {
   "start": 555.94,
   "end": 557.98,
   "text": "これねお裾直しが必要なんですよ"
  },
  {
   "start": 557.98,
   "end": 561.54,
   "text": "ユニクロだったらね当日仕上げとかでやってくれるんですけど"
  },
  {
   "start": 561.54,
   "end": 564.9,
   "text": "安いですしねGUも数百円とかでやってくれてますよね"
  },
  {
   "start": 564.9,
   "end": 568.04,
   "text": "他社はそうはいかないですから"
  },
  {
   "start": 568.04,
   "end": 571.9,
   "text": "いわゆるドメとかインポートそういうとこを買うと"
  },
  {
   "start": 571.9,
   "end": 575.6,
   "text": "良い服なんでちゃんとしたところでしたいってなってくると"
  },
  {
   "start": 575.6,
   "end": 578.78,
   "text": "ちゃんとしてなくても安くても最近1800円くらいしません？"
  },
  {
   "start": 578.78,
   "end": 579.88,
   "text": "空押しだけだし"
  },
  {
   "start": 579.88,
   "end": 584.54,
   "text": "行くっていう手間もあるし受け取るって手間もあるし"
  },
  {
   "start": 584.54,
   "end": 586.14,
   "text": "あれがめんどくさい"
  },
  {
   "start": 586.14,
   "end": 587.34,
   "text": "めちゃくちゃめんどくさいです"
  },
  {
   "start": 587.34,
   "end": 591.08,
   "text": "僕も先日ジャケット買ったんですよテイラードの"
  },
  {
   "start": 591.08,
   "end": 595.16,
   "text": "袖を1.5cm短くしたいみたいな"
  },
  {
   "start": 595.16,
   "end": 599.84,
   "text": "お直しで3800円かかって2週間待ったんですよ"
  },
  {
   "start": 599.84,
   "end": 603.28,
   "text": "だからもう季節変わっちまうし"
  },
  {
   "start": 603.28,
   "end": 606.44,
   "text": "もちろんお直し自体はすごい良いサービスだけど"
  },
  {
   "start": 606.44,
   "end": 609.2,
   "text": "進んでもお金かかるし時間もかかるし"
  },
  {
   "start": 609.2,
   "end": 611.08,
   "text": "マジでめんどくさいんですよね"
  },
  {
   "start": 611.08,
   "end": 615.38,
   "text": "だからお直しせずとも着れるようにshiunは日々作ってますね"
  },
  {
   "start": 615.38,
   "end": 617.0,
   "text": "そこは意識してます"
  },
  {
   "start": 617.0,
   "end": 619.24,
   "text": "神です"
  },
  {
   "start": 620.3,
   "end": 622.52,
   "text": "本当にね神ポイントが多いんですよ"
  },
  {
   "start": 622.52,
   "end": 624.82,
   "text": "ベストもかけるようにしてくれてる"
  },
  {
   "start": 624.82,
   "end": 626.18,
   "text": "でもお直しもいらない"
  },
  {
   "start": 626.18,
   "end": 629.02,
   "text": "ブランドとしては軸があるじゃないですか"
  },
  {
   "start": 629.02,
   "end": 630.88,
   "text": "だから変なこと言うと"
  },
  {
   "start": 630.88,
   "end": 635.58,
   "text": "去年買った服でも全然今年のアイテムと合わせられるみたいな"
  },
  {
   "start": 635.58,
   "end": 636.68,
   "text": "それは意識してますね"
  },
  {
   "start": 636.68,
   "end": 639.2,
   "text": "レイジ君のアイテムで着続けられる"
  },
  {
   "start": 639.2,
   "end": 641.78,
   "text": "もっと5年とかだったら違うんでしょうけどトレンドが"
  },
  {
   "start": 641.78,
   "end": 645.84,
   "text": "去年ぐらいだったら全然着れちゃうなんなら着ます今年"
  },
  {
   "start": 645.84,
   "end": 649.29,
   "text": "今年4年のエコレザーの"
  },
  {
   "start": 649.29,
   "end": 652.89,
   "text": "エコレザーって言っちゃいけないからエコ合皮レザー"
  },
  {
   "start": 652.89,
   "end": 653.99,
   "text": "エコレザーのアウター"
  },
  {
   "start": 653.99,
   "end": 654.99,
   "text": "エコレザー調みたいな"
  },
  {
   "start": 654.99,
   "end": 660.29,
   "text": "エコレザー調アウター着ます全然着ますあれ"
  },
  {
   "start": 660.29,
   "end": 664.65,
   "text": "お直しで言うとパンツとか"
  },
  {
   "start": 664.65,
   "end": 667.09,
   "text": "股上はなかなかお直しできないじゃないですか"
  },
  {
   "start": 667.09,
   "end": 670.19,
   "text": "そこのサイズもこだわってるんで"
  },
  {
   "start": 670.19,
   "end": 672.39,
   "text": "股下だけお直しして調整しても"
  },
  {
   "start": 672.39,
   "end": 675.73,
   "text": "既製品のパンツじゃ股上と股下のバランスが"
  },
  {
   "start": 675.73,
   "end": 678.51,
   "text": "それがまたおかしくなったりとかしません？"
  },
  {
   "start": 678.51,
   "end": 681.53,
   "text": "そこまで極めてなかったです"
  },
  {
   "start": 681.53,
   "end": 686.61,
   "text": "とりあえず履けるもの合うものを探すの精一杯で"
  },
  {
   "start": 686.61,
   "end": 689.47,
   "text": "そこまでもういかなかったですね"
  },
  {
   "start": 689.47,
   "end": 692.29,
   "text": "それでもshiunを選んでくれて嬉しいですね"
  },
  {
   "start": 692.29,
   "end": 695.73,
   "text": "なんとなくでshiunいいわと思ってくれてたんですね"
  },
  {
   "start": 695.73,
   "end": 700.79,
   "text": "履いてかっこいいなと思える単純に"
  },
  {
   "start": 707.44,
   "end": 711.18,
   "text": "shiunはねダサくないですよトレンドに合ってる"
  },
  {
   "start": 711.18,
   "end": 712.92,
   "text": "ちっちゃめに作られてる服って"
  },
  {
   "start": 712.92,
   "end": 716.84,
   "text": "ちょっと昔のトレンドっぽいシルエットだったり"
  },
  {
   "start": 716.84,
   "end": 721.02,
   "text": "ちょっとチープな素材だったり"
  },
  {
   "start": 721.86,
   "end": 722.54,
   "text": "shiunは違う"
  },
  {
   "start": 722.54,
   "end": 725.17,
   "text": "それもでもしゃーないんですよね"
  },
  {
   "start": 725.17,
   "end": 726.74,
   "text": "前調べた時に僕より前に"
  },
  {
   "start": 726.74,
   "end": 729.58,
   "text": "低身長メンズファッションみたいなやってたブランドがあって"
  },
  {
   "start": 729.58,
   "end": 732.54,
   "text": "そこが月の売上200万みたいな"
  },
  {
   "start": 732.54,
   "end": 735.14,
   "text": "それを超えるために頑張るみたいなって言ってたんですよ"
  },
  {
   "start": 735.14,
   "end": 739.06,
   "text": "shiunは秋冬だとあとめっちゃ少なくても1000万とか"
  },
  {
   "start": 739.06,
   "end": 741.82,
   "text": "多かったら2000万ぐらい売り上げの規模でやってて"
  },
  {
   "start": 741.82,
   "end": 743.8,
   "text": "ってことは服をいっぱい作ってるから"
  },
  {
   "start": 743.8,
   "end": 746.64,
   "text": "その分1個あたりの製作費が下がって"
  },
  {
   "start": 746.64,
   "end": 751.02,
   "text": "コスパのいいプライスに対して質がいいものを作れてるんですけど"
  },
  {
   "start": 751.02,
   "end": 753.3,
   "text": "やっぱ低身長アパイルファッションって"
  },
  {
   "start": 753.3,
   "end": 756.1,
   "text": "ターゲットがまず限定されていて"
  },
  {
   "start": 756.1,
   "end": 759.56,
   "text": "かつそこにリーチする力も持ってる人は少ない"
  },
  {
   "start": 759.56,
   "end": 760.84,
   "text": "僕みたいな走り者じゃないと"
  },
  {
   "start": 760.84,
   "end": 764.06,
   "text": "ということで質が良くて安いものを作りづらい"
  },
  {
   "start": 764.06,
   "end": 767.2,
   "text": "ビジネス体制なんですよね"
  },
  {
   "start": 767.2,
   "end": 770.7,
   "text": "だからshiunはそういうところも我ながらすごいなって思います"
  },
  {
   "start": 770.7,
   "end": 771.78,
   "text": "いいポイントだなと"
  },
  {
   "start": 771.78,
   "end": 776.36,
   "text": "あとげんじさんの会社と一緒に業務提携でやらせていただいてるんで"
  },
  {
   "start": 776.36,
   "end": 778.68,
   "text": "そこの生産ラインにも乗せていただいてるんで"
  },
  {
   "start": 778.68,
   "end": 780.78,
   "text": "意味わからんぐらい服作ってるじゃないですか"
  },
  {
   "start": 780.78,
   "end": 781.78,
   "text": "すごい人が受けてくれてるんで"
  },
  {
   "start": 781.78,
   "end": 783.94,
   "text": "その制作費も抑えてるんですよ"
  },
  {
   "start": 783.94,
   "end": 786.62,
   "text": "それもあってめちゃくちゃコスパのいいものを作れてるんですよ"
  },
  {
   "start": 786.62,
   "end": 788.73,
   "text": "あと言っていいですか"
  },
  {
   "start": 788.73,
   "end": 793.04,
   "text": "shiunチームはね少ない人が"
  },
  {
   "start": 793.04,
   "end": 793.9,
   "text": "それは悪口や"
  },
  {
   "start": 793.9,
   "end": 795.96,
   "text": "ディスじゃないですよ"
  },
  {
   "start": 795.96,
   "end": 798.58,
   "text": "もうずっと少ないじゃないですか"
  },
  {
   "start": 798.58,
   "end": 801.44,
   "text": "でもこんだけ良いものをたくさん人に届けてるって"
  },
  {
   "start": 801.44,
   "end": 805.24,
   "text": "本当にエキスパートエリートが集まっててみたいな"
  },
  {
   "start": 805.24,
   "end": 807.58,
   "text": "そんなことないです"
  },
  {
   "start": 807.58,
   "end": 810.6,
   "text": "それもあって安いですよね人件費が"
  },
  {
   "start": 810.6,
   "end": 814.46,
   "text": "まず店舗がないしかもチームも少ないみたいな"
  },
  {
   "start": 814.46,
   "end": 817.1,
   "text": "少ない生産数が多いってことです"
  },
  {
   "start": 817.1,
   "end": 818.94,
   "text": "どんどん減っていってますからね"
  },
  {
   "start": 818.94,
   "end": 822.46,
   "text": "最初もっとおったんです"
  },
  {
   "start": 824.13,
   "end": 826.23,
   "text": "げんじさんのチームのスタッフさんも力を貸しておいたりとか"
  },
  {
   "start": 826.23,
   "end": 827.45,
   "text": "いろいろあったんですけど"
  },
  {
   "start": 827.45,
   "end": 830.88,
   "text": "なぜか人が離れていくんです僕から"
  },
  {
   "start": 830.88,
   "end": 831.86,
   "text": "もう大丈夫だなって"
  },
  {
   "start": 831.86,
   "end": 832.98,
   "text": "離れていくんですよ人が"
  },
  {
   "start": 832.98,
   "end": 836.1,
   "text": "エキスパートいるなってこなせるなってなったんじゃないですか"
  },
  {
   "start": 836.1,
   "end": 837.96,
   "text": "いや人が離れていって"
  },
  {
   "start": 837.96,
   "end": 842.6,
   "text": "ルックも最初はちゃんと専門の人がおったけど僕になったり"
  },
  {
   "start": 842.6,
   "end": 846.14,
   "text": "僕のスナップ撮る人も最初は外注してたんですけど"
  },
  {
   "start": 846.14,
   "end": 848.38,
   "text": "それも今はマネージャーになりとか"
  },
  {
   "start": 848.38,
   "end": 851.14,
   "text": "マネージャーも地元の友達やしみたいな"
  },
  {
   "start": 851.14,
   "end": 852.86,
   "text": "人がどんどん減ってる"
  },
  {
   "start": 852.86,
   "end": 856.28,
   "text": "だからね本当にそれもあるんでしょうね"
  },
  {
   "start": 856.28,
   "end": 861.7,
   "text": "値段に乗っかってくるというかちゃんと安いじゃないですか"
  },
  {
   "start": 861.7,
   "end": 865.92,
   "text": "shiunの服マジで店舗で買おうとしたらマジで何万円なんだろう"
  },
  {
   "start": 865.92,
   "end": 868.44,
   "text": "いくら違うんだろうって毎回思うんですよね"
  },
  {
   "start": 868.44,
   "end": 870.04,
   "text": "正直それはありますね"
  },
  {
   "start": 870.04,
   "end": 871.6,
   "text": "セレオリとかで普通に売ってる"
  },
  {
   "start": 871.6,
   "end": 873.86,
   "text": "1万5千とかのシャツとか2万ぐらい"
  },
  {
   "start": 873.86,
   "end": 877.34,
   "text": "セレオリでも1万とか2万とか普通にするじゃないですか"
  },
  {
   "start": 877.34,
   "end": 879.6,
   "text": "驚きますたまに見に行くと"
  },
  {
   "start": 879.6,
   "end": 884.1,
   "text": "あの辺よりなんならちょっといいんじゃねって言われながら"
  },
  {
   "start": 884.1,
   "end": 884.7,
   "text": "ほんま思ってた"
  },
  {
   "start": 884.7,
   "end": 888.58,
   "text": "自ら言うと安っぽく感じますけどその発言自体が"
  },
  {
   "start": 888.58,
   "end": 895.53,
   "text": "本当に視聴者本当にそうびっくりするんですよ"
  },
  {
   "start": 895.53,
   "end": 899.21,
   "text": "あとファッションインフルエンサーで昔からやってる子さんにしては"
  },
  {
   "start": 899.21,
   "end": 904.19,
   "text": "僕の家が狭すぎるんでそこら辺もマジで乗っかってないと"
  },
  {
   "start": 904.19,
   "end": 910.57,
   "text": "家狭すぎるから服がコスパいいんですよマジで狭すぎる"
  },
  {
   "start": 911.15,
   "end": 914.69,
   "text": "まだ僕1階に住んでるんですからねマンション"
  },
  {
   "start": 914.69,
   "end": 918.07,
   "text": "1階がいいとこじゃなくて1階だったっていう"
  },
  {
   "start": 918.07,
   "end": 920.99,
   "text": "住みたいマンションが1階しか空いてなかったってことですか？"
  },
  {
   "start": 920.99,
   "end": 925.51,
   "text": "4年ぐらい住んでるんですけど金銭的な理由で1階でした"
  },
  {
   "start": 925.51,
   "end": 928.11,
   "text": "こういうインフルエンサーとかの友達で集まると"
  },
  {
   "start": 928.11,
   "end": 931.69,
   "text": "タワマン自慢がたまに始まる嫌な時間があるんですけど"
  },
  {
   "start": 931.69,
   "end": 933.91,
   "text": "そういう会は一度参加したけど"
  },
  {
   "start": 933.91,
   "end": 936.34,
   "text": "36階とかやれやみたいな話して"
  },
  {
   "start": 936.34,
   "end": 939.84,
   "text": "36階なんだって僕ちょっと郊外だから"
  },
  {
   "start": 939.84,
   "end": 942.38,
   "text": "むすさんここで46階とかに住んでて"
  },
  {
   "start": 942.38,
   "end": 945.06,
   "text": "Wi-Fiが電波悪くて大変だよみたいな"
  },
  {
   "start": 945.06,
   "end": 948.24,
   "text": "むすさんは僕1階ですよ"
  },
  {
   "start": 948.24,
   "end": 953.76,
   "text": "1階みたいな1階に人間が住めるの？みたいな"
  },
  {
   "start": 954.69,
   "end": 958.57,
   "text": "タワマン自慢じゃなくても1階ってなりますけどね"
  },
  {
   "start": 958.57,
   "end": 960.49,
   "text": "1階に住まなあかんぐらいの限界列でやらせていただいてます"
  },
  {
   "start": 960.49,
   "end": 963.67,
   "text": "すいません申し訳なくなってた"
  },
  {
   "start": 963.67,
   "end": 964.87,
   "text": "さすがに2階じゃねえか"
  },
  {
   "start": 964.87,
   "end": 968.15,
   "text": "今後は2階に住むどんどんアップしていく"
  },
  {
   "start": 968.15,
   "end": 974.33,
   "text": "6年目は2階10年目はもう5階ぐらいいくんで"
  },
  {
   "start": 974.75,
   "end": 979.91,
   "text": "結論なんですけど結論というか今まで言ってきたことを含めて"
  },
  {
   "start": 979.91,
   "end": 982.81,
   "text": "考える時間がなくなったんですよもう"
  },
  {
   "start": 982.81,
   "end": 987.09,
   "text": "休日にもう一日費やして悩むことも"
  },
  {
   "start": 987.09,
   "end": 991.29,
   "text": "ZOZOですっごい見て着丈とかもいろいろ見て探す時間も"
  },
  {
   "start": 991.29,
   "end": 995.37,
   "text": "全部なくなって今年のshiun買えばいいやみたいな"
  },
  {
   "start": 995.37,
   "end": 999.79,
   "text": "去年のshiun着ればいいや本当にこれ"
  },
  {
   "start": 999.79,
   "end": 1004.19,
   "text": "今日とかも朝早くてもう眠いと思いながら"
  },
  {
   "start": 1004.19,
   "end": 1007.55,
   "text": "でもshiun服ペッと取ってパッて出る"
  },
  {
   "start": 1007.55,
   "end": 1011.85,
   "text": "そこにこの服ちょっと嫌だなぁみたいな感情が一切ない"
  },
  {
   "start": 1011.85,
   "end": 1013.39,
   "text": "あーあんじゃんみたいな"
  },
  {
   "start": 1013.39,
   "end": 1016.53,
   "text": "それでもさってもいい気持ちでいられる"
  },
  {
   "start": 1016.53,
   "end": 1021.09,
   "text": "こんなね革命ないっすから"
  },
  {
   "start": 1021.57,
   "end": 1025.19,
   "text": "わむうさんしかね俺調べ不足かもしれないけど"
  },
  {
   "start": 1025.19,
   "end": 1027.85,
   "text": "他にあんのこの日本に？"
  },
  {
   "start": 1027.85,
   "end": 1032.17,
   "text": "XSブランドでこんなかっこいいブランドでこんな安いブランド"
  },
  {
   "start": 1032.17,
   "end": 1036.85,
   "text": "あったら教えて調べるからたまーになるけど"
  },
  {
   "start": 1036.85,
   "end": 1039.41,
   "text": "でもどっちかするとめっちゃこれ言ったら"
  },
  {
   "start": 1039.41,
   "end": 1041.47,
   "text": "ほんまに僕の写りが悪いんですけど"
  },
  {
   "start": 1041.47,
   "end": 1046.05,
   "text": "ほんまちっちゃいだけは作ってる人はちっちゃいが"
  },
  {
   "start": 1046.05,
   "end": 1049.75,
   "text": "蓋開けてみると別にその市場の一般的なサイズと変わらへん"
  },
  {
   "start": 1049.75,
   "end": 1052.75,
   "text": "みたいなのはよくあります"
  },
  {
   "start": 1052.75,
   "end": 1056.03,
   "text": "僕も一人インフルエンサーのブランド見に行ったんですけど"
  },
  {
   "start": 1056.03,
   "end": 1059.87,
   "text": "めっちゃでかくてでかくしてごまかそうってしてる感がすごくて"
  },
  {
   "start": 1059.87,
   "end": 1062.23,
   "text": "そうじゃないんだよなみたいな"
  },
  {
   "start": 1062.23,
   "end": 1065.37,
   "text": "オーバーサイズにしたらオシャレに見えますもんね"
  },
  {
   "start": 1065.37,
   "end": 1066.89,
   "text": "ちょっと前まではそれで分かったけど"
  },
  {
   "start": 1066.89,
   "end": 1069.65,
   "text": "今はその気分じゃないしみたいな"
  },
  {
   "start": 1069.65,
   "end": 1071.85,
   "text": "僕も最近スタイリング組む上で"
  },
  {
   "start": 1071.85,
   "end": 1077.13,
   "text": "パンツはshiunちょっと細めでアウターとかはデカめみたいな"
  },
  {
   "start": 1077.13,
   "end": 1079.33,
   "text": "今更そのブームが来てるんですけど"
  },
  {
   "start": 1079.33,
   "end": 1081.45,
   "text": "大きい服ってなんとなくオシャレに見えるんですけど"
  },
  {
   "start": 1081.45,
   "end": 1086.29,
   "text": "やっぱジャストとかちょっとゆったりぐらいのサイズの服が一番"
  },
  {
   "start": 1086.29,
   "end": 1089.87,
   "text": "僕作ってるからなんでむずいなっていうか"
  },
  {
   "start": 1089.87,
   "end": 1091.17,
   "text": "少ないなって思いますねほんまに"
  },
  {
   "start": 1091.17,
   "end": 1096.21,
   "text": "ほんまshiunはマジですごいなっていつも自分のクローゼットも"
  },
  {
   "start": 1096.21,
   "end": 1098.83,
   "text": "最近スタメンのクローゼットを入れ替えして"
  },
  {
   "start": 1098.83,
   "end": 1101.61,
   "text": "パンツいつも8本ぐらいですかスタメンの8本"
  },
  {
   "start": 1101.61,
   "end": 1106.75,
   "text": "トップスジャケット12着ぐらいみたいな感じのスタメンを"
  },
  {
   "start": 1106.75,
   "end": 1108.33,
   "text": "ラックがあるんですけど"
  },
  {
   "start": 1108.33,
   "end": 1112.15,
   "text": "パンツラックとか2本だけ他のブランドのパンツがあって"
  },
  {
   "start": 1112.15,
   "end": 1116.19,
   "text": "6本ぐらいはほぼshiunになって迷う時間がなくなった"
  },
  {
   "start": 1116.19,
   "end": 1119.69,
   "text": "とりあえずアウターでかくてバランスがなくても"
  },
  {
   "start": 1119.69,
   "end": 1121.45,
   "text": "shiunのパンツ履いておけばなんとかなるか"
  },
  {
   "start": 1121.45,
   "end": 1123.97,
   "text": "あと適当にshiunの靴合わせときゃなんとかなるかとか"
  },
  {
   "start": 1123.97,
   "end": 1126.99,
   "text": "迷う時間なくなったのは僕も同じです"
  },
  {
   "start": 1126.99,
   "end": 1128.63,
   "text": "本当にトップスとかアウターは"
  },
  {
   "start": 1128.63,
   "end": 1130.49,
   "text": "ワンチャンギリごまかせられるんですけど"
  },
  {
   "start": 1130.49,
   "end": 1133.31,
   "text": "パンツはねやっぱりウエストとか裾とか"
  },
  {
   "start": 1133.31,
   "end": 1136.39,
   "text": "問題結構意外とあるから"
  },
  {
   "start": 1136.39,
   "end": 1139.46,
   "text": "言うても靴もね爆売れしてるらしいじゃないですか"
  },
  {
   "start": 1139.46,
   "end": 1142.28,
   "text": "ウェアも僕は好きなんですけど"
  },
  {
   "start": 1142.28,
   "end": 1144.14,
   "text": "靴もshiunは売れてますね"
  },
  {
   "start": 1144.14,
   "end": 1146.9,
   "text": "靴もねやっぱかっこいい"
  },
  {
   "start": 1146.9,
   "end": 1149.58,
   "text": "XSに合う靴なんてまあないし"
  },
  {
   "start": 1149.58,
   "end": 1153.08,
   "text": "盛れる靴なんてねちょっとそんな調べてないけど"
  },
  {
   "start": 1153.08,
   "end": 1158.58,
   "text": "ダッサイなとか履くの恥ずかしいなじゃないけど負けた感というか"
  },
  {
   "start": 1158.58,
   "end": 1164.62,
   "text": "この靴買うためだけにこのブランド履くってすごい嫌だなって"
  },
  {
   "start": 1164.62,
   "end": 1166.42,
   "text": "shiunはこの流れで買うじゃないですか"
  },
  {
   "start": 1166.42,
   "end": 1171.62,
   "text": "この服が好きでこの服が出してる靴がスタイルアップできる靴"
  },
  {
   "start": 1171.62,
   "end": 1175.68,
   "text": "その文脈があると全然スッと履けるんですけど"
  },
  {
   "start": 1175.68,
   "end": 1179.74,
   "text": "何も文脈がない出しましたら盛れる靴"
  },
  {
   "start": 1179.74,
   "end": 1182.46,
   "text": "負けた感すごいですよそのブランドに"
  },
  {
   "start": 1182.46,
   "end": 1185.9,
   "text": "あと意味だから中国系のブランドですよね？"
  },
  {
   "start": 1185.9,
   "end": 1187.22,
   "text": "8cm10cm盛れますみたいな"
  },
  {
   "start": 1187.22,
   "end": 1189.5,
   "text": "かっこいい服出してないくせにとりあえず出していけばいいみたいな"
  },
  {
   "start": 1189.5,
   "end": 1194.94,
   "text": "そういうブランドに負けた感がすごい屈辱感があって"
  },
  {
   "start": 1194.94,
   "end": 1196.56,
   "text": "買わなかったんですけど"
  },
  {
   "start": 1196.56,
   "end": 1198.66,
   "text": "ちなみに身長を気にするならば"
  },
  {
   "start": 1198.66,
   "end": 1200.86,
   "text": "「とりあえず買って盛ったらええやん」っていう意見も"
  },
  {
   "start": 1200.86,
   "end": 1201.44,
   "text": "めっちゃわかるんですけど"
  },
  {
   "start": 1201.44,
   "end": 1205.92,
   "text": "なんとなくその抵抗感はありますよね僕はありました"
  },
  {
   "start": 1205.92,
   "end": 1209.9,
   "text": "あと昔で言うとジャンプとか広告にあったじゃないですか"
  },
  {
   "start": 1209.9,
   "end": 1211.24,
   "text": "8cm盛れるインソールとか"
  },
  {
   "start": 1211.24,
   "end": 1213.1,
   "text": "あれもうゲロダサかったじゃないですか"
  },
  {
   "start": 1213.1,
   "end": 1213.96,
   "text": "ゲロダサかった"
  },
  {
   "start": 1213.96,
   "end": 1216.52,
   "text": "そのイメージですよねインソールのヒューズって"
  },
  {
   "start": 1216.52,
   "end": 1218.46,
   "text": "意外と知ってるんで"
  },
  {
   "start": 1218.46,
   "end": 1221.92,
   "text": "意外とね意外と教えてるんで"
  },
  {
   "start": 1221.92,
   "end": 1222.92,
   "text": "そのイメージですよね"
  },
  {
   "start": 1222.92,
   "end": 1225.04,
   "text": "インソールシューズがダサいってなったら"
  },
  {
   "start": 1225.04,
   "end": 1227.4,
   "text": "多分そのイメージなんかなと思います"
  },
  {
   "start": 1227.4,
   "end": 1229.64,
   "text": "今ちょっとねshiun夫で会ってるんで"
  },
  {
   "start": 1229.64,
   "end": 1232.38,
   "text": "あんま調べてないんですけど"
  },
  {
   "start": 1232.38,
   "end": 1236.28,
   "text": "あとshiunの靴は我ながら安いとは思いますね"
  },
  {
   "start": 1236.28,
   "end": 1240.42,
   "text": "本革で身長が4.5とインソール1.5で6cm盛れて"
  },
  {
   "start": 1240.42,
   "end": 1244.76,
   "text": "ローファーとか14,300円税込み"
  },
  {
   "start": 1244.76,
   "end": 1247.44,
   "text": "でもこれってウィムと違う革っすよね"
  },
  {
   "start": 1247.44,
   "end": 1249.68,
   "text": "若干違いますね"
  },
  {
   "start": 1249.68,
   "end": 1252.12,
   "text": "革にももちろんグレードがめちゃくちゃあって"
  },
  {
   "start": 1252.12,
   "end": 1255.26,
   "text": "もちろん最高級ではないです"
  },
  {
   "start": 1255.26,
   "end": 1258.8,
   "text": "でもただ1万4300円にしては十分よく見えるし"
  },
  {
   "start": 1258.8,
   "end": 1262.48,
   "text": "ドメとかインポートの服僕結構好きで着るんですけど"
  },
  {
   "start": 1262.48,
   "end": 1268.16,
   "text": "そこと合わせても安っぽく見えないような素材にはしてますね"
  },
  {
   "start": 1272.34,
   "end": 1273.21,
   "text": "結論2"
  },
  {
   "start": 1273.21,
   "end": 1274.29,
   "text": "2もあるんですよ"
  },
  {
   "start": 1274.29,
   "end": 1275.41,
   "text": "結論2もあったよ"
  },
  {
   "start": 1275.41,
   "end": 1277.95,
   "text": "結論2"
  },
  {
   "start": 1277.95,
   "end": 1281.07,
   "text": "shiunはね失敗がないんですよ"
  },
  {
   "start": 1281.07,
   "end": 1283.79,
   "text": "僕全部アイテム見てるんですけど"
  },
  {
   "start": 1283.79,
   "end": 1287.01,
   "text": "もちろん好みのアイテムは買うんですけど"
  },
  {
   "start": 1287.01,
   "end": 1289.89,
   "text": "shiunはどれ買ってもまずハズレがない"
  },
  {
   "start": 1289.89,
   "end": 1291.19,
   "text": "ハズレがないって言い方も変だけど"
  },
  {
   "start": 1291.19,
   "end": 1294.21,
   "text": "分かりますよどんだけ好きなブランドでも"
  },
  {
   "start": 1294.21,
   "end": 1296.75,
   "text": "これちょっとなんかなっていうのたまにありますもん"
  },
  {
   "start": 1296.75,
   "end": 1299.05,
   "text": "なんならこんな良かったなみたいな"
  },
  {
   "start": 1299.05,
   "end": 1301.55,
   "text": "画面上では伝わらない素材の良さが"
  },
  {
   "start": 1301.55,
   "end": 1305.33,
   "text": "生で見たら思ったと思うんで"
  },
  {
   "start": 1305.33,
   "end": 1311.61,
   "text": "めっちゃいいじゃんみたいなっていう体験が得られるはずです"
  },
  {
   "start": 1312.45,
   "end": 1314.65,
   "text": "そんなカタス作ってるわけじゃなくて"
  },
  {
   "start": 1314.65,
   "end": 1318.17,
   "text": "まだベーシックなものを揃えていこうという段階で僕は思ってるんで"
  },
  {
   "start": 1318.17,
   "end": 1320.89,
   "text": "そんな飛ばしたアイテムもあんま作ってない"
  },
  {
   "start": 1320.89,
   "end": 1322.69,
   "text": "ハズレアイテム"
  },
  {
   "start": 1322.69,
   "end": 1325.21,
   "text": "一押しアイテムはもちろんあるんですけど"
  },
  {
   "start": 1325.21,
   "end": 1327.57,
   "text": "これはやばいハズレだなっていうアイテムは"
  },
  {
   "start": 1327.57,
   "end": 1329.55,
   "text": "そもそも出さないようにはしてますね"
  },
  {
   "start": 1329.55,
   "end": 1333.69,
   "text": "サンプル作りまくって出せそうなぐらいのやつできたけど"
  },
  {
   "start": 1333.69,
   "end": 1336.95,
   "text": "あんまやったらもうめちゃくちゃ赤字でも出さないみたいなことは"
  },
  {
   "start": 1336.95,
   "end": 1340.17,
   "text": "しょっちゅうありますんでそこはご安心してください"
  },
  {
   "start": 1340.17,
   "end": 1346.05,
   "text": "ということで皆さんもぜひshiunを買ってみてください"
  },
  {
   "start": 1346.05,
   "end": 1347.35,
   "text": "締めっすね"
  },
  {
   "start": 1347.35,
   "end": 1354.13,
   "text": "結論1と2が終わった後締め1締め2もあるから"
  },
  {
   "start": 1354.13,
   "end": 1358.91,
   "text": "僕みたいに悩んでて画面上じゃ伝わりきれずに"
  },
  {
   "start": 1358.91,
   "end": 1361.49,
   "text": "買いしぶってる人全然いると思うんですけど"
  },
  {
   "start": 1361.49,
   "end": 1364.59,
   "text": "1回買ってみてほしいですね"
  },
  {
   "start": 1364.59,
   "end": 1366.15,
   "text": "ぜひお願いします"
  },
  {
   "start": 1366.15,
   "end": 1367.11,
   "text": "そんな感じです"
  },
  {
   "start": 1367.11,
   "end": 1370.01,
   "text": "終わりっぽいんだ"
  },
  {
   "start": 1370.01,
   "end": 1372.97,
   "text": "死は死命中で終わりっぽい"
  },
  {
   "start": 1372.97,
   "end": 1374.81,
   "text": "燃え尽きちゃった"
  },
  {
   "start": 1374.81,
   "end": 1378.51,
   "text": "本当に思いが熱すぎて"
  },
  {
   "start": 1378.51,
   "end": 1379.75,
   "text": "炎者感エグかった"
  },
  {
   "start": 1379.75,
   "end": 1383.61,
   "text": "いい意味ですよ"
  },
  {
   "start": 1383.61,
   "end": 1385.87,
   "text": "金払ってる感がすごいあった"
  },
  {
   "start": 1385.87,
   "end": 1388.51,
   "text": "あったと思うんですよ"
  },
  {
   "start": 1388.51,
   "end": 1391.77,
   "text": "ガチですからね"
  },
  {
   "start": 1392.87,
   "end": 1397.15,
   "text": "言わせた感があるんじゃないんかと思ってたぶん心配してる"
  },
  {
   "start": 1397.15,
   "end": 1402.66,
   "text": "言いたくて言いたくて言いたくて震えてるぐらいなんで"
  },
  {
   "start": 1402.66,
   "end": 1405.52,
   "text": "ほんまにshiunのXSサイズは"
  },
  {
   "start": 1405.52,
   "end": 1408.02,
   "text": "本当に自信持ってオススメできますし"
  },
  {
   "start": 1408.02,
   "end": 1413.52,
   "text": "基本的に他のブランドってでかいサイズでサンプル作るんですよ"
  },
  {
   "start": 1413.52,
   "end": 1416.54,
   "text": "撮影用のあれなんで190cmとかの外国人とか"
  },
  {
   "start": 1416.54,
   "end": 1419.78,
   "text": "その辺のイケメンが来てかっこよくなるのサンプルで作って"
  },
  {
   "start": 1419.78,
   "end": 1423.02,
   "text": "そこからグレードダウンしていってSとかを作るんですけど"
  },
  {
   "start": 1423.02,
   "end": 1427.1,
   "text": "ただshiunは164cmの僕を基準レース作って"
  },
  {
   "start": 1427.1,
   "end": 1431.56,
   "text": "そこからグレードアップするかダウンするか作っていて"
  },
  {
   "start": 1431.56,
   "end": 1433.96,
   "text": "XSの人ももちろんめちゃくちゃユーザーとしては多いんですよ"
  },
  {
   "start": 1433.96,
   "end": 1437.08,
   "text": "3割ぐらいはXSユーザーの写真のことは"
  },
  {
   "start": 1437.08,
   "end": 1440.54,
   "text": "絶対に切り捨てられない数字じゃないですか"
  },
  {
   "start": 1440.54,
   "end": 1441.26,
   "text": "当たり前ですよ"
  },
  {
   "start": 1441.26,
   "end": 1444.88,
   "text": "普通のブランドはSなんで12割とか"
  },
  {
   "start": 1444.88,
   "end": 1446.4,
   "text": "何かも似合いとかなのかもしれない"
  },
  {
   "start": 1446.4,
   "end": 1448.02,
   "text": "2枚とか多いんですよね"
  },
  {
   "start": 1448.02,
   "end": 1451.5,
   "text": "そうなってくるとそっちよりもML"
  },
  {
   "start": 1451.5,
   "end": 1454.26,
   "text": "平均以上の人のサイズを優先絶対するんですよ"
  },
  {
   "start": 1454.26,
   "end": 1458.98,
   "text": "でもshiunはXSを優先的にかっこよくなるように作ってるんで"
  },
  {
   "start": 1458.98,
   "end": 1462.66,
   "text": "本当にXSユーザーの皆さんはいつもありがとうございます"
  },
  {
   "start": 1462.66,
   "end": 1466.12,
   "text": "そしてXSとかSとかshiunを検討してる方は"
  },
  {
   "start": 1466.12,
   "end": 1470.84,
   "text": "安心してぜひとも買ってくださいお願いします"
  },
  {
   "start": 1470.84,
   "end": 1473.2,
   "text": "身長6cmもローファーなんかも"
  },
  {
   "start": 1473.2,
   "end": 1476.88,
   "text": "この動画出してる時期はリリースしてるかもしれませんが"
  },
  {
   "start": 1476.88,
   "end": 1480.36,
   "text": "ブランド終わるぐらい数作ったんでぜひ買ってください"
  },
  {
   "start": 1480.36,
   "end": 1482.06,
   "text": "そんな作ったんですね"
  },
  {
   "start": 1482.06,
   "end": 1486.84,
   "text": "買えないって声が多すぎて一回行こうかってことで"
  },
  {
   "start": 1486.84,
   "end": 1487.82,
   "text": "素晴らしい決断です"
  },
  {
   "start": 1487.82,
   "end": 1491.78,
   "text": "エグい数作ってるんでぜひ気になった方は買ってください"
  },
  {
   "start": 1491.78,
   "end": 1494.1,
   "text": "普段shiun買ってくれてる方も多いですよね"
  },
  {
   "start": 1494.1,
   "end": 1498.32,
   "text": "感想をコメント欄で書いていただけるととても嬉しいです"
  },
  {
   "start": 1498.32,
   "end": 1501.74,
   "text": "塚田さんのインスタあとはスレッドですね"
  },
  {
   "start": 1501.74,
   "end": 1504.24,
   "text": "スレッドはね服関係あんま載せてないんですけど"
  },
  {
   "start": 1504.24,
   "end": 1504.88,
   "text": "載せてないですか"
  },
  {
   "start": 1504.88,
   "end": 1507.0,
   "text": "スレッドはちょっと可愛いと思う女性に"
  },
  {
   "start": 1507.0,
   "end": 1508.66,
   "text": "コメントしていってるアカウント"
  },
  {
   "start": 1508.66,
   "end": 1511.96,
   "text": "コメントするのとする活動をしてると"
  },
  {
   "start": 1511.96,
   "end": 1514.77,
   "text": "趣味の植物ばっかり"
  },
  {
   "start": 1514.77,
   "end": 1515.49,
   "text": "いいね来ないんですよ"
  },
  {
   "start": 1515.49,
   "end": 1518.95,
   "text": "いいねしてくれたらねスレッズも書くんですけど"
  },
  {
   "start": 1518.95,
   "end": 1521.45,
   "text": "みんな植物だけいいね来るんですよ"
  },
  {
   "start": 1521.45,
   "end": 1522.97,
   "text": "おしゃれなミラーボールとか"
  },
  {
   "start": 1522.97,
   "end": 1528.43,
   "text": "それで隠して女性にコメントしてるのがメインですよね"
  },
  {
   "start": 1528.43,
   "end": 1533.77,
   "text": "いつも出てくるんですよマジで"
  },
  {
   "start": 1533.77,
   "end": 1537.47,
   "text": "意味わからん女子の投稿出てきたなと思ったら"
  },
  {
   "start": 1537.47,
   "end": 1539.41,
   "text": "つかにーがコメントして"
  },
  {
   "start": 1539.41,
   "end": 1541.99,
   "text": "これみんな気をつけてくださいね"
  },
  {
   "start": 1541.99,
   "end": 1546.39,
   "text": "返してない人に何にも繋がりないのに回っちゃうんですよ"
  },
  {
   "start": 1546.39,
   "end": 1548.57,
   "text": "女の子へのコメント別に普段から"
  },
  {
   "start": 1548.57,
   "end": 1550.19,
   "text": "びっくりしちゃうんだから"
  },
  {
   "start": 1550.19,
   "end": 1554.83,
   "text": "別に塚田さんのスレッズ見ようとかも別にないんですよ正直"
  },
  {
   "start": 1554.83,
   "end": 1557.71,
   "text": "俺誰一人もフォローしてないのにスレッズで社内の人"
  },
  {
   "start": 1557.71,
   "end": 1561.57,
   "text": "その時に気の見ましたよみたいな"
  },
  {
   "start": 1561.95,
   "end": 1567.03,
   "text": "いや怖いっすよね全部ね漏れなく100%見られちゃうんですよ"
  },
  {
   "start": 1567.03,
   "end": 1568.41,
   "text": "全部言われちゃうびっくり"
  },
  {
   "start": 1568.41,
   "end": 1571.41,
   "text": "塚田さんと小林さんファッションユーチューバーの"
  },
  {
   "start": 1571.41,
   "end": 1572.91,
   "text": "おしゃれなこの2人が"
  },
  {
   "start": 1572.91,
   "end": 1578.67,
   "text": "おしゃれなメガネがめっちゃね女の子にコメントしてるんですよ"
  },
  {
   "start": 1578.67,
   "end": 1581.89,
   "text": "女の子のDM待ってます"
  },
  {
   "start": 1581.89,
   "end": 1586.43,
   "text": "結婚してないんですごいね優良物件ですので"
  },
  {
   "start": 1586.43,
   "end": 1588.91,
   "text": "ぜひともお願いします"
  },
  {
   "start": 1588.91,
   "end": 1590.98,
   "text": "WEARですよWEARを"
  },
  {
   "start": 1590.98,
   "end": 1592.96,
   "text": "WEAR仕様に載っけてくださってますよね"
  },
  {
   "start": 1592.96,
   "end": 1595.2,
   "text": "インスタとWEARを見てください"
  },
  {
   "start": 1595.2,
   "end": 1597.06,
   "text": "WEARの方が投稿してるかな"
  },
  {
   "start": 1597.06,
   "end": 1600.0,
   "text": "素敵な写真をアップしてるんでよかったらご覧ください"
  },
  {
   "start": 1600.0,
   "end": 1603.3,
   "text": "では今回もご視聴いただきましてありがとうございました"
  },
  {
   "start": 1603.3,
   "end": 1603.96,
   "text": "ありがとうございました"
  },
  {
   "start": 1603.96,
   "end": 1607.82,
   "text": "ぜひとも今後とも使う人もフォロワーさんもお願いします"
  },
  {
   "start": 1607.82,
   "end": 1609.72,
   "text": "ではまたお会いしましょう"
  },
  {
   "start": 1609.72,
   "end": 1610.32,
   "text": "以上アリーヴェデルチ"
  }
 ],
