  },
  {
   "start": 547.26,
   "end": 703.44,
   "text": "②お直しもいらない"
  },
  {
   "start": 703.44,
   "end": 974.79,
   "text": "③shiunはダサくない"
  },
  {
   "start": 974.79,
   "end": 1232.31,
   "text": "考える時間がなくなった"
  },
  {
   "start": 1232.31,
   "end": 1272.72,
   "text": "shiunの靴は安い"
  },
  {
   "start": 1272.72,
   "end": 1340.51,
   "text": "shiunは失敗がない"
  },
  {
   "start": 1340.51,
   "end": 1498.56,
   "text": "まとめ"
  },
  {
   "start": 1498.56,
