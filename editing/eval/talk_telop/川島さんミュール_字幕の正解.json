 },
 {
  "start": 46.2,
  "text": "ゆとりがある＝歩くとパカパカする",
  "end": 47.4
 },
 {
  "start": 47.4,
  "text": "みたいな風に",
  "end": 48.1
 },
 {
  "start": 48.1,
  "text": "イメージしちゃうかもしれないんだけど",
  "end": 49.1
 },
 {
  "start": 49.1,
  "text": "でもフィット感もすごいある",
  "end": 50.3
 },
 {
  "start": 50.3,
  "text": "ア内側にとれてるの馨ぎ見〕を",
