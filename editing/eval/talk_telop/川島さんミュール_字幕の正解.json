  "end": 96.8
 },
 {
  "start": 96.8,
  "text": "ちょっと気にしてたところがあって。",
  "end": 97.9
 },
 {
  "start": 97.9,
  "text": "でも、この靴履いた時だけ",
  "end": 99.4
 },
 {
