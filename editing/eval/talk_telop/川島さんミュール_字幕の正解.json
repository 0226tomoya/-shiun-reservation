  "text": "足のサイドが固定されて",
  "end": 53.2
 },
 {
  "start": 53.2,
  "text": "パカパカしにくいっていうのは",
  "end": 54.4
 },
 {
  "start": 54.4,
  "text": "考えてますね",
  "end": 55.3
 },
 {
  "start": 55.3,
  "text": "やっぱshiunといえば",
  "end": 56.4
 },
 {
  "start": 56.4,
  "text": "身長が盛れる",
  "end": 57.3
 },
 {
  "start": 57.3,
  "text": "やっぱ170cm台でも",
  "end": 59.1
 },
 {
  "start": 59.1,
  "text": "身長盛りたい気持ちはあるのよ",
  "end": 60.5
 },
 {
  "start": 60.5,
  "text": "だから俺も",
  "end": 61.3
 },
 {
  "start": 61.3,
  "text": "180cmが理想ではあったけど",
  "end": 63.6
 },
 {
  "start": 63.6,
  "text": "やっぱそれに近づけてくれる",
  "end": 64.9
 },
 {
  "start": 64.9,
  "text": "カッコいい",
  "end": 65.5
 },
 {
  "start": 65.5,
  "text": "しかも履きやすい",
  "end": 66.3
 },
 {
  "start": 66.3,
  "text": "んでもって身長盛れるって",
  "end": 67.4
 },
 {
  "start": 67.4,
  "text": "俺の中ではもう買おうって決めて",
  "end": 68.5
 },
 {
  "start": 68.5,
  "text": "すぐ買って",
  "end": 69.1
 },
 {
  "start": 69.1,
  "text": "週7で履いてるわけですよ",
  "end": 70.5
 },
 {
  "start": 70.5,
  "text": "週7で履いてくれているってことは",
  "end": 72.5
 },
 {
  "start": 72.5,
  "text": "歩行性というか",
  "end": 73.2
 },
 {
  "start": 73.2,
  "text": "疲れづらさも十分あるってことですか？",
  "end": 74.9
 },
 {
  "start": 74.9,
  "text": "作る段階で",
  "end": 75.7
 },
 {
  "start": 75.7,
  "text": "フィット感を高めていることによって",
  "end": 78.5
 },
 {
  "start": 78.5,
  "text": "歩きづらさは全然感じない",
  "end": 80.6
 },
 {
  "start": 80.6,
  "text": "今どんな感じなんですか？",
  "end": 81.6
 },
 {
  "start": 81.6,
  "text": "経年変化の感じは",
  "end": 82.3
 },
 {
  "start": 82.3,
  "text": "絶妙な経年変化みたいなのが出てる",
  "end": 84.8
 },
 {
  "start": 84.8,
  "text": "2ヶ月週7で履いて",
  "end": 86.1
 },
 {
  "start": 86.1,
  "text": "靴底の減りもこんな感じで",
  "end": 87.2
 },
 {
  "start": 87.2,
  "text": "丈夫ってことね",
  "end": 87.9
 },
 {
  "start": 87.9,
  "text": "彼女さんからの感想とかもらってます？",
  "end": 89.8
 },
 {
  "start": 89.8,
  "text": "僕の彼女180cmないと",
  "end": 92.2
 },
 {
  "start": 92.2,
