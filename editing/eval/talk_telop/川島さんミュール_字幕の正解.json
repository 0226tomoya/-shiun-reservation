 },
 {
  "start": 38.1,
  "text": "(アッパーが)硬すぎて",
  "end": 39.0
 },
 {
  "start": 39.0,
  "text": "靴擦れするんですよ(履き口)が",
  "end": 40.8
 },
 {
  "start": 40.8,
  "text": "それはないですか今のところ？",
  "end": 41.8
 },
 {
  "start": 41.8,
  "text": "全然ない",
  "end": 43.2
 },
 {
  "start": 43.2,
  "text": "結構ねこの中の空間ゆとりあって",
