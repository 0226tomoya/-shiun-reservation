                                    <fadeOut type="easeIn" duration="782/720000s"/>
                                </param>
                            </adjust-volume>
                            <mc-source angleID="/ce6nHk9RcC6Yo2Qvah6LQ" srcEnable="video"/>
                            <mc-source angleID="OTPA/Te2REeayU6ZgP4/sg" srcEnable="audio"/>
                            <filter-audio ref="r33" name="Limiter">
                                <data key="effectState"></data>
                                <param name="Gain [dB]" key="1" value="+4.0" auxValue="240"/>
                                <param name="Output Level [dB]" key="5" value="-2.0" auxValue="80"/>
                            </filter-audio>
                        </mc-clip>
                        <asset-clip ref="r64" offset="38244206/60000s" name="エンディング" duration="204204/24000s" format="r30" tcFormat="NDF" audioRole="dialogue">
                            <conform-rate scaleEnabled="0" srcFrameRate="23.98"/>
                            <adjust-volume amount="-96dB"/>
                        </asset-clip>
                    </spine>
                </sequence>
            </project>
        </event>
        <smart-collection name="プロジェクト" match="all">
            <match-clip rule="is" type="project"/>
        </smart-collection>
        <smart-collection name="すべてのビデオ" match="any">
            <match-media rule="is" type="videoOnly"/>
            <match-media rule="is" type="videoWithAudio"/>
        </smart-collection>
        <smart-collection name="オーディオのみ" match="all">
            <match-media rule="is" type="audioOnly"/>
        </smart-collection>
        <smart-collection name="静止画" match="all">
            <match-media rule="is" type="stills"/>
        </smart-collection>
        <smart-collection name="よく使う項目" match="all">
            <match-ratings value="favorites"/>
        </smart-collection>
        <smart-collection name="解析がありません" match="all">
            <match-analysis-type rule="isMissing" value="any"/>
        </smart-collection>
    </library>
</fcpxml>