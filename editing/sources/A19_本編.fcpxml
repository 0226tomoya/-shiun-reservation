                            <title ref="r40" lane="7" offset="42442400/60000s" name="その生地を染色後、空気の力で生地を揉み込む&quot;空気洗い&quot;をかけることで - 基本タイトル" start="216800584/60000s" duration="678678/60000s">
                                <param name="位置" key="9999/999166631/999166633/1/100/101" value="0 -442.42"/>
                                <param name="平坦化" key="9999/999166631/999166633/2/351" value="1"/>
