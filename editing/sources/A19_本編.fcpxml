                            <title ref="r40" lane="7" offset="70347277/60000s" name="全体的に少し細めのシルエットで、膝下をほんの少しだけフレアさせました - 基本タイトル" start="216173958/60000s" duration="300300/60000s">
                                <param name="位置" key="9999/999166631/999166633/1/100/101" value="1 -483.734"/>
                                <param name="平坦化" key="9999/999166631/999166633/2/351" value="1"/>
