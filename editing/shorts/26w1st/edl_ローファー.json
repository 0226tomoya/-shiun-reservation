   "at": 30.2302,
   "dur": 1.368
  },
  {
   "text": "4.5cm",
   "at": 31.5982,
   "dur": 1.6516
  },
  {
   "text": "インソールが1.5cmと",
   "at": 33.2499,
   "dur": 2.7861
  },
  {
   "text": "合計6cm",
   "at": 36.036,
   "dur": 1.4514
  },
  {
   "text": "自然に身長が盛れます",
   "at": 37.4874,
   "dur": 1.9019
  },
  {
   "text": "ソールの存在感を隠せるように",
   "at": 39.3893,
   "dur": 3.2699
  },
  {
   "text": "やや細くなっているヒールと",
   "at": 42.6593,
   "dur": 2.8528
  },
  {
   "text": "真ん中を",
   "at": 45.5121,
   "dur": 1.2346
  },
  {
   "text": "くり抜いたソール",
   "at": 46.7467,
   "dur": 1.4181
  },
  {
   "text": "前のソールは",
   "at": 48.1648,
   "dur": 1.2512
  },
  {
   "text": "疲れないクッション性を",
   "at": 49.416,
   "dur": 2.2022
  },
  {
   "text": "効かせながらも",
   "at": 51.6182,
   "dur": 1.2346
  },
  {
   "text": "できるだけ薄く",
   "at": 52.8528,
   "dur": 1.1178
  },
  {
   "text": "そして",
   "at": 53.9706,
   "dur": 0.9009
  },
  {
   "text": "一番人の視線を集める",
   "at": 54.8715,
   "dur": 2.1188
  },
  {
   "text": "センター部分 ここは",
