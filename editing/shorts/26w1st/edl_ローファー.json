  {
   "text": "4.5cm",
   "at": 33.4501,
   "dur": 1.8518
  },
  {
   "text": "インソールが1.5cmと",
   "at": 35.3019,
   "dur": 2.8362
  },
  {
   "text": "合計6cm",
   "at": 38.1381,
   "dur": 1.4848
  },
  {
   "text": "自然に身長が盛れます",
   "at": 39.6229,
   "dur": 1.9186
  },
  {
   "text": "ソールの存在感を隠せるように",
