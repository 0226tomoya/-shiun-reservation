   "dur": 2.7194
  },
  {
   "text": "ローファー特有の",
   "at": 80.4137,
   "dur": 1.5182
  },
  {
   "text": "窮屈感もない",
   "at": 81.9319,
   "dur": 1.4848
  },
  {
   "text": "楽に履けて",
