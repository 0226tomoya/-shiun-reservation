  },
  {
   "text": "こっそり背を伸ばしたい",
   "at": 5.7224,
   "dur": 1.9019
  },
  {
   "text": "男子だけ見てください",
   "at": 7.6243,
   "dur": 1.7851
  },
  {
   "text": "所詮人は第一印象が全て",
   "at": 9.4094,
   "dur": 3.1532
  },
  {
   "text": "まず会った瞬間に",
   "at": 12.5626,
   "dur": 1.7851
  },
  {
   "text": "低身長男性ほど",
   "at": 14.3477,
   "dur": 1.8185
  },
  {
   "text": "会った瞬間の身長を",
   "at": 16.1662,
   "dur": 2.319
  },
  {
   "text": "重視した方が絶対にいい",
   "at": 18.4851,
   "dur": 2.0354
  },
  {
   "text": "このソールの薄さで",
   "at": 20.5205,
   "dur": 3.2866
  },
  {
