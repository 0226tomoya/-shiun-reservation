  },
  {
   "text": "盛っていない自分",
   "at": 3.0697,
   "dur": 0.9343
  },
  {
   "text": "こっそり背を伸ばしたい",
   "at": 4.004,
   "dur": 1.8018
  },
  {
   "text": "男子だけ見てください",
   "at": 5.8058,
   "dur": 1.318
  },
  {
   "text": "所詮人は第一印象が全て",
   "at": 7.1238,
   "dur": 2.3857
  },
  {
   "text": "まず会った瞬間に",
   "at": 9.5095,
   "dur": 1.5182
  },
  {
   "text": "低身長男性ほど",
   "at": 11.0277,
   "dur": 1.4515
  },
  {
   "text": "会った瞬間の身長を",
   "at": 12.4791,
   "dur": 1.952
  },
  {
   "text": "重視した方が絶対にいい",
   "at": 14.4311,
   "dur": 1.8352
  },
  {
   "text": "このソールの薄さで",
   "at": 16.2663,
   "dur": 2.1188
  },
  {
   "text": "身長が6cm盛れる",
   "at": 18.385,
   "dur": 2.4858
  },
  {
   "text": "牛革のローファーを",
   "at": 20.8709,
   "dur": 1.8352
  },
  {
   "text": "作りました",
   "at": 22.706,
   "dur": 0.7507
  },
  {
   "text": "このローファーは",
   "at": 23.4568,
   "dur": 0.9843
  },
  {
   "text": "アウトソールが",
   "at": 24.4411,
   "dur": 1.0511
  },
  {
   "text": "4.5cm",
   "at": 25.4921,
   "dur": 1.4514
  },
  {
   "text": "インソールが1.5cmと",
   "at": 26.9436,
   "dur": 2.2689
  },
  {
   "text": "合計6cm",
   "at": 29.2125,
   "dur": 1.3013
  },
  {
   "text": "自然に身長が盛れます",
   "at": 30.5138,
   "dur": 1.5182
  },
  {
   "text": "ソールの存在感を隠せるように",
   "at": 32.032,
   "dur": 2.7528
  },
  {
   "text": "やや細くなっているヒールと",
   "at": 34.7848,
   "dur": 2.319
  },
  {
   "text": "真ん中を",
   "at": 37.1037,
   "dur": 0.684
  },
  {
   "text": "くり抜いたソール",
   "at": 37.7878,
   "dur": 1.7351
  },
  {
   "text": "前のソールは",
   "at": 39.5228,
   "dur": 0.9509
  },
  {
   "text": "疲れないクッション性を",
   "at": 40.4738,
   "dur": 1.5349
  },
  {
   "text": "効かせながらも",
   "at": 42.0086,
   "dur": 1.0177
  },
  {
   "text": "できるだけ薄く",
   "at": 43.0263,
   "dur": 0.9343
  },
  {
   "text": "そして",
   "at": 43.9606,
   "dur": 0.4004
  },
  {
   "text": "一番人の視線を集める",
   "at": 44.361,
   "dur": 1.6517
  },
  {
   "text": "センター部分 ここは",
   "at": 46.0126,
   "dur": 1.1178
  },
  {
   "text": "一般的なローファーとは違い",
   "at": 47.1304,
   "dur": 2.1355
  },
  {
   "text": "ソールが見えないような",
   "at": 49.2659,
   "dur": 1.7351
  },
  {
   "text": "デザインにしました",
   "at": 51.001,
   "dur": 2.1355
  },
  {
   "text": "なので見た目は",
   "at": 53.1364,
   "dur": 0.7174
  },
  {
   "text": "普通の牛革ローファーですが",
   "at": 53.8538,
