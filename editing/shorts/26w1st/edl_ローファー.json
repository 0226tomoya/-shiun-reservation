   "dur": 3.8205
  },
  {
   "text": "やや細くなっているヒールと",
   "at": 45.362,
   "dur": 2.9363
  },
  {
   "text": "真ん中を",
   "at": 48.2982,
   "dur": 1.2346
  },
  {
   "text": "くり抜いたソール",
   "at": 49.5328,
   "dur": 1.4181
  },
  {
   "text": "前のソールは",
   "at": 50.9509,
   "dur": 1.7851
  },
  {
   "text": "疲れないクッション性を",
   "at": 52.736,
   "dur": 1.9353
  },
  {
   "text": "効かせながらも",
   "at": 54.6713,
   "dur": 1.2846
  },
  {
   "text": "できるだけ薄く",
   "at": 55.9559,
   "dur": 1.1178
  },
  {
   "text": "一番人の視線を集める",
   "at": 57.0737,
   "dur": 2.1355
  },
  {
   "text": "センター部分 ここは",
   "at": 59.2092,
   "dur": 1.635
