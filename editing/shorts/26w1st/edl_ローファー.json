  {
   "text": "これが盛っていない自分",
   "at": 3.3534,
   "dur": 2.4358
  },
  {
   "text": "こっそり背を伸ばしたい",
   "at": 5.7891,
   "dur": 2.0521
  },
  {
   "text": "男子だけ見てください",
   "at": 7.8412,
   "dur": 1.7851
  },
  {
   "text": "所詮人は第一印象が全て",
   "at": 9.6263,
   "dur": 3.2032
  },
  {
   "text": "まず会った瞬間に",
   "at": 12.8295,
   "dur": 1.7851
  },
  {
   "text": "低身長男性ほど",
   "at": 14.6146,
   "dur": 1.8185
  },
  {
   "text": "会った瞬間の身長を",
   "at": 16.4331,
   "dur": 2.319
  },
  {
   "text": "重視した方が絶対にいい",
   "at": 18.7521,
   "dur": 2.0354
  },
  {
   "text": "このソールの薄さで",
   "at": 20.7874,
   "dur": 2.6693
  },
  {
   "text": "身長が6cm盛れる",
   "at": 23.4568,
   "dur": 3.1198
  },
  {
   "text": "牛革のローファーを",
   "at": 26.5766,
   "dur": 2.0687
  },
  {
   "text": "作りました",
   "at": 28.6453,
   "dur": 1.1011
  },
  {
   "text": "このローファーは",
   "at": 29.7464,
   "dur": 1.1845
  },
  {
   "text": "アウトソールが",
   "at": 30.9309,
   "dur": 1.368
  },
  {
   "text": "4.5cm",
   "at": 32.2989,
   "dur": 1.8518
  },
  {
   "text": "インソールが1.5cmと",
   "at": 34.1508,
   "dur": 2.9196
  },
  {
   "text": "合計6cm",
   "at": 37.0704,
   "dur": 1.4848
  },
  {
   "text": "自然に身長が盛れます",
   "at": 38.5552,
   "dur": 1.9186
  },
  {
   "text": "ソールの存在感を隠せるように",
   "at": 40.4738,
   "dur": 3.8205
  },
  {
   "text": "やや細くなっているヒールと",
   "at": 44.2943,
   "dur": 2.9363
  },
  {
   "text": "真ん中を",
   "at": 47.2305,
   "dur": 1.2346
  },
  {
   "text": "くり抜いたソール",
   "at": 48.4651,
   "dur": 1.4181
  },
  {
   "text": "前のソールは",
   "at": 49.8832,
   "dur": 1.7851
  },
  {
   "text": "疲れないクッション性を",
   "at": 51.6683,
   "dur": 1.9353
  },
  {
   "text": "効かせながらも",
   "at": 53.6036,
   "dur": 1.2846
  },
  {
   "text": "できるだけ薄く",
   "at": 54.8882,
   "dur": 1.1178
  },
  {
   "text": "一番人の視線を集める",
   "at": 56.006,
   "dur": 2.1355
  },
  {
   "text": "センター部分 ここは",
   "at": 58.1414,
   "dur": 1.6517
  },
  {
   "text": "一般的なローファーとは違い",
   "at": 59.7931,
   "dur": 2.2856
  },
  {
   "text": "ソールが見えないような",
   "at": 62.0787,
   "dur": 2.002
  },
  {
   "text": "デザインにしました",
   "at": 64.0807,
   "dur": 1.2346
  },
  {
   "text": "なので見た目は",
   "at": 65.3153,
   "dur": 1.1345
  },
  {
   "text": "普通の牛革ローファーですが",
   "at": 66.4497,
   "dur": 2.5526
  },
