 "subs": [
  {
   "text": "これが盛っていない自分",
   "at": 3.3534,
   "dur": 2.4358
  },
  {
   "text": "こっそり背を伸ばしたい",
   "at": 5.7891,
   "dur": 2.0521
  },
  {
   "text": "男子だけ見てください",
   "at": 7.8412,
   "dur": 1.7851
  },
  {
   "text": "所詮人は第一印象が全て",
   "at": 9.6263,
   "dur": 3.2032
  },
  {
   "text": "まず会った瞬間に",
   "at": 12.8295,
   "dur": 1.7851
  },
  {
   "text": "低身長男性ほど",
   "at": 14.6146,
   "dur": 1.8185
  },
  {
   "text": "会った瞬間の身長を",
   "at": 16.4331,
   "dur": 2.319
  },
  {
   "text": "重視した方が絶対にいい",
   "at": 18.7521,
   "dur": 2.0354
  },
  {
   "text": "このソールの薄さで",
   "at": 20.7874,
   "dur": 3.5869
  },
  {
   "text": "身長が6cm盛れる",
   "at": 24.3744,
   "dur": 3.8372
  },
  {
   "text": "牛革のローファーを",
   "at": 28.2115,
   "dur": 2.686
  },
  {
   "text": "作りました",
   "at": 30.8975,
   "dur": 1.1011
  },
  {
   "text": "このローファーは",
   "at": 31.9986,
   "dur": 1.1845
  },
  {
   "text": "アウトソールが",
   "at": 33.1832,
   "dur": 1.368
  },
  {
   "text": "4.5cm",
   "at": 34.5512,
   "dur": 1.8518
  },
  {
   "text": "インソールが1.5cmと",
   "at": 36.403,
   "dur": 2.9196
  },
  {
   "text": "合計6cm",
   "at": 39.3226,
   "dur": 1.4848
  },
  {
   "text": "自然に身長が盛れます",
   "at": 40.8074,
   "dur": 1.9186
  },
  {
   "text": "ソールの存在感を隠せるように",
   "at": 42.726,
   "dur": 3.8205
  },
  {
   "text": "やや細くなっているヒールと",
   "at": 46.5465,
   "dur": 2.9363
  },
  {
   "text": "真ん中を",
   "at": 49.4828,
   "dur": 1.2346
  },
  {
   "text": "くり抜いたソール",
   "at": 50.7173,
   "dur": 1.4181
  },
  {
   "text": "前のソールは",
   "at": 52.1354,
   "dur": 1.7851
  },
  {
   "text": "疲れないクッション性を",
   "at": 53.9205,
   "dur": 1.9353
  },
  {
   "text": "効かせながらも",
   "at": 55.8558,
   "dur": 1.2846
  },
  {
   "text": "できるだけ薄く",
   "at": 57.1404,
   "dur": 1.1178
  },
  {
   "text": "一番人の視線を集める",
   "at": 58.2582,
   "dur": 2.1355
  },
  {
   "text": "センター部分 ここは",
   "at": 60.3937,
   "dur": 1.6517
  },
  {
   "text": "一般的なローファーとは違い",
   "at": 62.0453,
   "dur": 2.2856
  },
  {
   "text": "ソールが見えないような",
   "at": 64.3309,
   "dur": 2.002
  },
  {
   "text": "デザインにしました",
   "at": 66.3329,
   "dur": 2.7527
  },
  {
   "text": "なので見た目は",
   "at": 69.0857,
   "dur": 1.1345
  },
  {
   "text": "普通の牛革ローファーですが",
   "at": 70.2201,
   "dur": 2.5526
  },
  {
   "text": "身長が6cmも盛れてしまう",
   "at": 72.7727,
   "dur": 2.7527
  },
  {
   "text": "そんなローファーになっています",
   "at": 75.5255,
   "dur": 1.5682
  },
  {
   "text": "そして脱ぎ履きしやすいように",
   "at": 77.0937,
   "dur": 3.1531
  },
  {
   "text": "靴の内側に",
   "at": 80.2468,
   "dur": 1.1511
  },
  {
   "text": "ゴムを採用しております",
   "at": 81.398,
   "dur": 2.7194
  },
  {
   "text": "ローファー特有の",
   "at": 84.1174,
   "dur": 1.5182
  },
  {
   "text": "窮屈感もない",
   "at": 85.6355,
   "dur": 1.4848
  },
  {
   "text": "楽に履けて",
   "at": 87.1204,
   "dur": 1.5849
  },
  {
   "text": "もちろんインソールの",
   "at": 88.7053,
   "dur": 1.2679
  },
  {
   "text": "クッション性もあり",
   "at": 89.9732,
   "dur": 2.686
  },
  {
   "text": "歩いていても",
   "at": 92.6592,
   "dur": 1.1845
  },
  {
   "text": "疲れにくい設計にしております",
