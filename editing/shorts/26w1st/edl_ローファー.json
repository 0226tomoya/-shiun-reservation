  },
  {
   "text": "こっそり背を伸ばしたい",
   "at": 5.1551,
   "dur": 1.9019
  },
  {
   "text": "男子だけ見てください",
   "at": 7.057,
   "dur": 1.7851
  },
  {
   "text": "所詮人は第一印象が全て",
   "at": 8.8422,
   "dur": 3.0697
  },
  {
   "text": "まず会った瞬間に",
   "at": 11.9119,
   "dur": 1.7017
  },
  {
   "text": "低身長男性ほど",
   "at": 13.6136,
   "dur": 1.8185
  },
  {
   "text": "会った瞬間の身長を",
   "at": 15.4321,
   "dur": 2.0854
  },
  {
   "text": "重視した方が絶対にいい",
   "at": 17.5175,
   "dur": 1.8018
  },
  {
   "text": "このソールの薄さで",
   "at": 19.3193,
   "dur": 3.0864
  },
  {
   "text": "身長が6cm盛れる",
   "at": 22.4057,
   "dur": 2.9029
  },
  {
   "text": "牛革のローファーを",
