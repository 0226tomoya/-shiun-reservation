 "subs": [
  {
   "text": "低身長はコートも革ジャンも",
   "at": 5.0384,
   "dur": 3.7371
  },
  {
   "text": "似合わないから着ないほうがいい",
   "at": 8.7754,
   "dur": 2.0187
  },
  {
   "text": "そう思ってる方は",
   "at": 10.7941,
   "dur": 1.318
  },
  {
   "text": "きっと多いですよね",
   "at": 12.1121,
   "dur": 1.3347
  },
  {
   "text": "今年の秋冬の主役級の",
   "at": 13.4468,
   "dur": 2.7694
  },
  {
   "text": "アウターがレザーカーコート",
   "at": 16.2162,
   "dur": 3.2533
  },
  {
   "text": "低身長だからカーコートは諦める",
   "at": 19.4694,
   "dur": 3.7537
  },
  {
   "text": "そう思っている方も多いと思います",
   "at": 23.2232,
   "dur": 2.7694
  },
  {
   "text": "ただ諦めるのは終わりです",
   "at": 25.9926,
   "dur": 2.1521
  },
  {
   "text": "カーコートはコートという",
   "at": 28.1448,
   "dur": 3.37
  },
  {
   "text": "名前が付いているだけで",
   "at": 31.5148,
   "dur": 2.4691
  },
  {
   "text": "着丈も長く",
   "at": 33.984,
   "dur": 1.3347
  },
  {
   "text": "各パーツのサイズも",
   "at": 35.3186,
   "dur": 1.5516
  },
  {
   "text": "身幅や肩幅全部が",
   "at": 36.8702,
   "dur": 2.6193
  },
  {
   "text": "デカすぎるものが多かった",
   "at": 39.4895,
   "dur": 1.5516
  },
  {
   "text": "本革や合皮のコートは",
   "at": 41.041,
   "dur": 1.9186
  },
  {
   "text": "生地が硬い分",
   "at": 42.9596,
   "dur": 1.7518
  },
  {
   "text": "サイズ感がごまかせずに",
   "at": 44.7113,
   "dur": 2.9529
  },
  {
   "text": "着られている感が",
   "at": 47.6643,
   "dur": 1.318
  },
  {
   "text": "強く出てしまっていた",
   "at": 48.9823,
   "dur": 1.1678
  },
  {
   "text": "低身長に合うカーコートは",
   "at": 50.1501,
   "dur": 2.4358
  },
  {
   "text": "これまで存在しなかったです",
   "at": 52.5859,
   "dur": 2.2856
  },
  {
   "text": "そこで164cmの僕が",
   "at": 54.8715,
   "dur": 2.7027
  },
  {
   "text": "作っているshiunで",
   "at": 57.5742,
   "dur": 1.635
  },
  {
   "text": "低身長にしか似合わない",
   "at": 59.2092,
   "dur": 2.0354
  },
  {
   "text": "カーコートを作りました",
   "at": 61.2445,
   "dur": 1.2179
  },
  {
   "text": "サイズ展開が",
   "at": 62.4624,
   "dur": 1.0844
  },
  {
   "text": "XSからMサイズの展開です",
   "at": 63.5468,
   "dur": 2.8695
  },
  {
   "text": "158cmの方が着ても",
   "at": 66.4164,
   "dur": 2.1688
  },
  {
   "text": "164cmの僕が着ても",
   "at": 68.5852,
   "dur": 2.4191
  },
  {
   "text": "168cmの男性が着ても",
   "at": 71.0043,
   "dur": 2.5525
  },
  {
   "text": "程よくゆったりしている",
   "at": 73.5568,
   "dur": 1.7851
  },
  {
   "text": "着ててもゴワゴワせず",
   "at": 75.3419,
   "dur": 1.9853
  },
  {
   "text": "着ていても疲れない",
   "at": 77.3273,
   "dur": 1.4681
  },
  {
   "text": "そして張り感が少ない素材を",
   "at": 78.7954,
   "dur": 2.7027
  },
  {
   "text": "使っているからこそ生まれる",
   "at": 81.4981,
   "dur": 1.952
  },
  {
   "text": "このドレープ感",
   "at": 83.45,
   "dur": 2.1021
  },
  {
   "text": "カーコートを着てみたいけど",
   "at": 85.5521,
   "dur": 1.8685
  },
  {
   "text": "諦めていた低身長男性にこそ",
   "at": 87.4207,
   "dur": 2.4191
  },
  {
   "text": "挑戦してほしいアウターです",
   "at": 89.8398,
   "dur": 2.1855
  }
 ],
