 "subs": [
  {
   "text": "低身長はコートも革ジャンも",
   "at": 4.645,
   "dur": 2.975
  },
  {
   "text": "似合わないから着ないほうがいい",
   "at": 7.62,
   "dur": 1.76
  },
  {
   "text": "そう思ってる方は",
   "at": 9.38,
   "dur": 1.125
  },
  {
   "text": "きっと多いですよね",
   "at": 10.505,
   "dur": 1.145
  },
  {
   "text": "今年の秋冬の主役級の",
   "at": 11.65,
   "dur": 2.995
  },
  {
   "text": "アウターがレザーカーコート",
   "at": 14.645,
   "dur": 2.845
  },
  {
   "text": "低身長だからカーコートは諦める",
   "at": 17.49,
   "dur": 3.455
  },
  {
   "text": "そう思っている方も多いと思います",
   "at": 20.945,
   "dur": 2.28
  },
  {
   "text": "ただ諦めるのは終わりです",
   "at": 23.225,
   "dur": 1.845
  },
  {
   "text": "カーコートはコートという",
   "at": 25.07,
   "dur": 2.445
  },
  {
   "text": "名前が付いているだけで",
   "at": 27.515,
   "dur": 2.44
  },
  {
   "text": "着丈も長く",
   "at": 29.955,
   "dur": 1.195
  },
  {
   "text": "各パーツのサイズも",
   "at": 31.15,
   "dur": 1.505
  },
  {
   "text": "身幅や肩幅全部が",
   "at": 32.655,
   "dur": 1.925
  },
  {
   "text": "デカすぎるものが多かった",
   "at": 34.58,
   "dur": 1.445
  },
  {
   "text": "本革や合皮のコートは",
   "at": 36.025,
   "dur": 1.8
  },
  {
   "text": "生地が硬い分",
   "at": 37.825,
   "dur": 1.42
  },
  {
   "text": "サイズ感がごまかせずに",
   "at": 39.245,
   "dur": 2.37
  },
  {
   "text": "着られている感が",
   "at": 41.615,
   "dur": 1.225
  },
  {
   "text": "強く出てしまっていた",
   "at": 42.84,
   "dur": 1.185
  },
  {
   "text": "低身長に合うカーコートは",
   "at": 44.025,
   "dur": 2.16
  },
  {
   "text": "これまで存在しなかったです",
   "at": 46.185,
   "dur": 1.73
  },
  {
   "text": "そこで164cmの僕が",
   "at": 47.915,
   "dur": 2.03
  },
  {
   "text": "作っているshiunで",
   "at": 49.945,
   "dur": 1.54
  },
  {
   "text": "低身長にしか似合わない",
   "at": 51.485,
   "dur": 1.685
  },
  {
   "text": "カーコートを作りました",
   "at": 53.17,
   "dur": 1.055
  },
  {
   "text": "サイズ展開が",
   "at": 54.225,
   "dur": 0.985
  },
  {
   "text": "XSからMサイズの展開です",
   "at": 55.21,
   "dur": 2.815
  },
  {
   "text": "158cmの方が着ても",
   "at": 58.025,
   "dur": 2.04
  },
  {
   "text": "164cmの僕が着ても",
   "at": 60.065,
   "dur": 2.07
  },
  {
   "text": "168cmの男性が着ても",
   "at": 62.135,
   "dur": 2.33
  },
  {
   "text": "程よくゆったりしている",
   "at": 64.465,
   "dur": 1.465
  },
  {
   "text": "着ててもゴワゴワせず",
   "at": 65.93,
   "dur": 1.84
  },
  {
   "text": "着ていても疲れない",
   "at": 67.77,
   "dur": 1.27
  },
  {
   "text": "そして張り感が少ない素材を",
   "at": 69.04,
   "dur": 2.32
  },
  {
   "text": "使っているからこそ生まれる",
   "at": 71.36,
   "dur": 1.76
  },
  {
   "text": "このドレープ感",
   "at": 73.12,
   "dur": 1.615
  },
  {
   "text": "カーコートを着てみたいけど",
   "at": 74.735,
   "dur": 1.82
  },
  {
   "text": "諦めていた低身長男性にこそ",
   "at": 76.555,
   "dur": 2.27
  },
  {
   "text": "挑戦してほしいアウターです",
   "at": 78.825,
   "dur": 1.61
  },
  {
   "text": "shiunのオンラインストアで",
   "at": 80.435,
   "dur": 1.82
  },
  {
   "text": "下記の日程で発売します",
   "at": 82.255,
   "dur": 1.57
  },
  {
