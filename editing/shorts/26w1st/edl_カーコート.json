 "subs": [
  {
   "text": "低身長はコートも革ジャンも",
   "at": 5.055,
   "dur": 3.7371
  },
  {
   "text": "似合わないから着ないほうがいい",
   "at": 8.7921,
   "dur": 2.0187
  },
  {
   "text": "そう思ってる方は",
   "at": 10.8108,
   "dur": 1.3347
  },
  {
   "text": "きっと多いですよね",
   "at": 12.1455,
   "dur": 1.318
  },
  {
   "text": "今年の秋冬の主役級の",
   "at": 13.4635,
   "dur": 2.8362
  },
  {
   "text": "アウターがレザーカーコート",
   "at": 16.2996,
   "dur": 3.2533
  },
  {
   "text": "低身長だからカーコートは諦める",
   "at": 19.5529,
   "dur": 3.9206
  },
  {
   "text": "そう思っている方も多いと思います",
   "at": 23.4735,
   "dur": 2.7694
  },
  {
   "text": "ただ諦めるのは終わりです",
   "at": 26.2429,
   "dur": 2.1521
  },
  {
   "text": "カーコートはコートという",
   "at": 28.395,
   "dur": 3.32
  },
  {
   "text": "名前が付いているだけで",
   "at": 31.715,
   "dur": 2.5192
  },
  {
   "text": "着丈も長く",
   "at": 34.2342,
   "dur": 1.3347
  },
  {
   "text": "各パーツのサイズも",
   "at": 35.5689,
   "dur": 1.5516
  },
  {
   "text": "身幅や肩幅全部が",
   "at": 37.1204,
   "dur": 2.7194
  },
  {
   "text": "デカすぎるものが多かった",
   "at": 39.8398,
   "dur": 1.5516
  },
  {
   "text": "本革や合皮のコートは",
   "at": 41.3914,
   "dur": 1.9186
  },
  {
   "text": "生地が硬い分",
   "at": 43.3099,
   "dur": 1.8018
  },
  {
   "text": "サイズ感がごまかせずに",
   "at": 45.1117,
   "dur": 2.9863
  },
  {
   "text": "着られている感が",
   "at": 48.098,
   "dur": 1.318
  },
  {
   "text": "強く出てしまっていた",
   "at": 49.416,
   "dur": 1.2179
  },
  {
   "text": "低身長に合うカーコートは",
   "at": 50.6339,
   "dur": 2.4358
  },
  {
   "text": "これまで存在しなかったです",
   "at": 53.0697,
   "dur": 2.2856
  },
  {
   "text": "そこで164cmの僕が",
   "at": 55.3553,
   "dur": 2.7361
  },
  {
   "text": "作っているshiunで",
   "at": 58.0914,
   "dur": 1.685
  },
  {
   "text": "低身長にしか似合わない",
   "at": 59.7764,
   "dur": 2.0354
  },
  {
   "text": "カーコートを作りました",
   "at": 61.8118,
   "dur": 1.2346
  },
  {
   "text": "サイズ展開が",
   "at": 63.0463,
   "dur": 1.1845
  },
  {
   "text": "XSからMサイズの展開です",
   "at": 64.2308,
   "dur": 3.003
  },
  {
   "text": "158cmの方が着ても",
   "at": 67.2338,
   "dur": 2.1688
  },
  {
   "text": "164cmの僕が着ても",
   "at": 69.4027,
   "dur": 2.4191
  },
  {
   "text": "168cmの男性が着ても",
   "at": 71.8218,
   "dur": 2.5525
  },
  {
   "text": "程よくゆったりしている",
   "at": 74.3743,
   "dur": 1.8185
  },
  {
   "text": "着ててもゴワゴワせず",
   "at": 76.1928,
   "dur": 2.0687
  },
  {
   "text": "着ていても疲れない",
   "at": 78.2615,
   "dur": 1.4681
  },
  {
   "text": "そして張り感が少ない素材を",
   "at": 79.7296,
   "dur": 2.7361
  },
  {
   "text": "使っているからこそ生まれる",
   "at": 82.4657,
   "dur": 1.9686
  },
  {
   "text": "このドレープ感",
   "at": 84.4343,
   "dur": 2.2689
  },
  {
   "text": "カーコートを着てみたいけど",
   "at": 86.7033,
   "dur": 1.9686
  },
  {
   "text": "諦めていた低身長男性にこそ",
   "at": 88.6719,
   "dur": 2.4191
  },
  {
   "text": "挑戦してほしいアウターです",
   "at": 91.091,
   "dur": 2.1688
  }
 ],
