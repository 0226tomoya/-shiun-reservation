 "inserts": [],
 "subs": [
  {
   "text": "低身長はコートも革ジャンも",
   "at": 5.55,
   "dur": 3.335
  },
  {
   "text": "似合わないから着ないほうがいいよ",
   "at": 8.885,
   "dur": 1.85
  },
  {
   "text": "そう思っている方は多いですよね",
   "at": 10.735,
   "dur": 3.325
  },
  {
   "text": "今年の秋冬の主役級の",
   "at": 14.06,
   "dur": 2.805
  },
  {
   "text": "アウターがレザーカーコートです",
   "at": 16.865,
   "dur": 3.73
  },
  {
   "text": "低身長だからカーコートは諦める",
   "at": 20.595,
   "dur": 3.455
  },
  {
   "text": "そう思っている方も多いと思います",
   "at": 24.05,
   "dur": 2.28
  },
  {
   "text": "ただ諦めるのは終わりです",
   "at": 26.33,
   "dur": 1.845
  },
  {
   "text": "カーコートはコートという",
   "at": 28.175,
   "dur": 2.445
  },
  {
   "text": "名前が付いているだけで",
   "at": 30.62,
   "dur": 2.01
  },
  {
   "text": "着丈も長く",
   "at": 32.63,
   "dur": 1.195
  },
  {
   "text": "各パーツのサイズも",
   "at": 33.825,
   "dur": 1.505
  },
  {
   "text": "身幅や肩幅全部が",
   "at": 35.33,
   "dur": 1.925
  },
  {
   "text": "デカすぎるものが多かった",
   "at": 37.255,
   "dur": 1.445
  },
  {
   "text": "本革や合皮のコートは",
   "at": 38.7,
   "dur": 2.155
  },
  {
   "text": "生地が硬い分",
   "at": 40.855,
   "dur": 1.42
  },
  {
   "text": "サイズ感がごまかせずに",
   "at": 42.275,
   "dur": 2.37
  },
  {
   "text": "着られている感が",
   "at": 44.645,
   "dur": 1.225
  },
  {
   "text": "強く出てしまっていた",
   "at": 45.87,
   "dur": 1.185
  },
  {
   "text": "低身長に合うカーコートは",
   "at": 47.055,
   "dur": 2.16
  },
  {
   "text": "これまで存在しなかったです",
   "at": 49.215,
   "dur": 1.73
  },
  {
   "text": "そこで164センチの僕が",
   "at": 50.945,
   "dur": 2.03
  },
  {
   "text": "作っているshiunで",
   "at": 52.975,
   "dur": 1.68
  },
  {
   "text": "低身長にしか似合わない",
   "at": 54.655,
   "dur": 1.685
  },
  {
   "text": "カーコートを作りました",
   "at": 56.34,
   "dur": 1.055
  },
  {
   "text": "サイズ展開が",
   "at": 57.395,
   "dur": 1.115
  },
  {
   "text": "XSからMサイズの展開です",
   "at": 58.51,
   "dur": 2.815
  },
  {
   "text": "158センチの方が着ても",
   "at": 61.325,
   "dur": 2.04
  },
  {
   "text": "164センチの僕が着ても",
   "at": 63.365,
   "dur": 2.07
  },
  {
   "text": "168センチの男性が着ても",
   "at": 65.435,
   "dur": 2.33
  },
  {
   "text": "程よくゆったりしている",
   "at": 67.765,
   "dur": 1.465
  },
  {
   "text": "着ててもゴワゴワせず",
   "at": 69.23,
   "dur": 1.84
  },
  {
   "text": "着ていても疲れない",
   "at": 71.07,
   "dur": 1.27
  },
  {
   "text": "そして張り感が少ない素材を",
   "at": 72.34,
   "dur": 2.32
  },
  {
   "text": "使っているからこそ生まれる",
   "at": 74.66,
   "dur": 1.76
  },
  {
   "text": "このドレープ感",
   "at": 76.42,
   "dur": 1.615
  },
  {
   "text": "カーコートを着てみたいけど",
   "at": 78.035,
   "dur": 1.82
  },
  {
   "text": "諦めていた低身長男性にこそ",
   "at": 79.855,
   "dur": 2.27
  },
  {
   "text": "挑戦してほしいアウターです",
   "at": 82.125,
   "dur": 1.61
  },
  {
   "text": "shiunのオンラインストアで",
   "at": 83.735,
   "dur": 1.82
  },
  {
   "text": "下記の日程で発売します",
   "at": 85.555,
   "dur": 1.57
  },
  {
   "text": "低身長でも諦めない冬にしましょう",
   "at": 87.125,
   "dur": 2.435
  }
 ],
