 "subs": [
  {
   "text": "低身長はコートも革ジャンも",
   "at": 4.9883,
   "dur": 3.6703
  },
  {
   "text": "似合わないから着ないほうがいい",
   "at": 8.6586,
   "dur": 1.9853
  },
  {
   "text": "そう思ってる方は",
   "at": 10.644,
   "dur": 1.3013
  },
  {
   "text": "きっと多いですよね",
   "at": 11.9453,
   "dur": 1.3513
  },
  {
   "text": "今年の秋冬の主役級の",
   "at": 13.2966,
   "dur": 2.7694
  },
  {
   "text": "アウターがレザーカーコート",
   "at": 16.066,
   "dur": 3.2032
  },
  {
   "text": "低身長だからカーコートは諦める",
   "at": 19.2692,
   "dur": 3.8872
  },
  {
   "text": "そう思っている方も多いと思います",
   "at": 23.1565,
   "dur": 2.7194
  },
  {
   "text": "もう諦めるのは終わりです",
   "at": 25.8758,
   "dur": 2.0854
  },
  {
   "text": "カーコートはコートという",
   "at": 27.9613,
   "dur": 3.2533
  },
  {
   "text": "名前が付いているだけあって",
   "at": 31.2145,
   "dur": 2.5359
  },
  {
   "text": "着丈も長く",
   "at": 33.7504,
   "dur": 1.318
  },
  {
   "text": "各パーツのサイズも",
   "at": 35.0684,
   "dur": 1.5516
  },
  {
   "text": "身幅や肩幅全部が",
   "at": 36.6199,
   "dur": 2.686
  },
  {
   "text": "デカすぎるものが多かった",
   "at": 39.3059,
   "dur": 1.5349
  },
  {
   "text": "本革や合皮のコートは",
   "at": 40.8408,
   "dur": 1.9186
  },
  {
   "text": "生地が硬い分",
   "at": 42.7594,
   "dur": 1.8018
  },
  {
   "text": "サイズ感がごまかせずに",
   "at": 44.5612,
   "dur": 2.9363
  },
  {
   "text": "着られている感が",
   "at": 47.4974,
   "dur": 1.3013
  },
  {
   "text": "強く出てしまっていた",
   "at": 48.7987,
   "dur": 1.2012
  },
  {
   "text": "低身長に合うカーコートは",
   "at": 49.9999,
   "dur": 2.4191
  },
  {
   "text": "これまで存在しなかったです",
   "at": 52.419,
   "dur": 2.2356
  },
  {
   "text": "そこで164cmの僕が",
   "at": 54.6546,
   "dur": 2.6693
  },
  {
   "text": "作っているshiunで",
   "at": 57.3239,
   "dur": 1.635
  },
  {
   "text": "低身長にしか似合わない",
   "at": 58.9589,
   "dur": 2.0354
  },
  {
   "text": "カーコートを作りました",
   "at": 60.9943,
   "dur": 1.2346
  },
  {
   "text": "サイズ展開が",
   "at": 62.2288,
   "dur": 1.1678
  },
  {
   "text": "XSからMサイズの展開です",
   "at": 63.3967,
   "dur": 2.9863
  },
  {
   "text": "158cmの方が着ても",
   "at": 66.383,
   "dur": 2.1521
  },
  {
   "text": "164cmの僕が着ても",
   "at": 68.5351,
   "dur": 2.4024
  },
  {
   "text": "168cmの男性が着ても",
   "at": 70.9375,
   "dur": 2.5692
  },
  {
   "text": "程よくゆったりしている",
   "at": 73.5068,
   "dur": 1.5182
  },
  {
   "text": "着ててもゴワゴワせず",
   "at": 75.0249,
   "dur": 2.0354
  },
  {
   "text": "着ていても疲れない",
   "at": 77.0603,
   "dur": 1.4348
  },
  {
   "text": "そして張り感が少ない素材を",
   "at": 78.4951,
   "dur": 2.7194
  },
  {
   "text": "使っているからこそ生まれる",
   "at": 81.2145,
   "dur": 1.9853
  },
  {
   "text": "このレープ感",
   "at": 83.1998,
   "dur": 1.7351
  },
  {
   "text": "カーコートを着てみたいけど",
   "at": 84.9348,
   "dur": 1.952
  },
  {
   "text": "諦めていた低身長男性にこそ",
   "at": 86.8868,
   "dur": 2.4024
  },
  {
