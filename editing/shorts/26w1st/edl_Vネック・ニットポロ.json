   "dur": 1.4
  },
  {
   "text": "そもそも低身長男性を",
   "at": 25.865,
   "dur": 2.08
  },
  {
   "text": "ターゲットにしていないから",
   "at": 27.945,
   "dur": 1.49
  },
  {
