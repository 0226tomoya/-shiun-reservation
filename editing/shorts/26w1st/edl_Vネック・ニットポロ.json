 "subs": [
  {
   "text": "158cmでも",
   "at": 2.4191,
   "dur": 1.6183
  },
  {
   "text": "164cmでも",
   "at": 4.0374,
   "dur": 1.8018
  },
  {
   "text": "ほどよく短丈で",
   "at": 5.8392,
   "dur": 1.8352
  },
  {
   "text": "ちょうどいいサイズ感で着れる",
   "at": 7.6744,
   "dur": 1.9686
  },
  {
   "text": "Vネックニットを作りました",
   "at": 9.643,
   "dur": 1.9853
  },
  {
   "text": "僕たち低身長男性",
   "at": 11.6283,
   "dur": 1.6684
  },
  {
   "text": "一般的なニットだと",
   "at": 13.2967,
   "dur": 1.9853
  },
  {
   "text": "Sサイズでも",
   "at": 15.282,
   "dur": 1.685
  },
  {
   "text": "着丈が長すぎたり",
   "at": 16.967,
   "dur": 1.7017
  },
  {
   "text": "逆に身幅が狭すぎたりと",
   "at": 18.6687,
   "dur": 3.0364
  },
  {
   "text": "ちょうどよく着れるニットって",
   "at": 21.7051,
   "dur": 2.1354
  },
  {
   "text": "なかなかないですよね",
   "at": 23.8405,
   "dur": 1.6517
  },
  {
   "text": "サイズ感や色に妥協する",
   "at": 25.4922,
   "dur": 2.4191
  },
  {
   "text": "高いブランドも",
   "at": 27.9113,
   "dur": 1.5182
  },
  {
   "text": "プチプラのブランドも",
   "at": 29.4295,
   "dur": 1.6516
  },
  {
   "text": "そもそも低身長男性を",
   "at": 31.0811,
   "dur": 2.2856
  },
  {
   "text": "ターゲットにしていないから",
   "at": 33.3667,
   "dur": 1.6183
  },
  {
   "text": "どれもサイズがデカすぎる",
   "at": 34.985,
   "dur": 2.3023
  },
  {
   "text": "そこで164cmの僕が着ても",
   "at": 37.2873,
   "dur": 3.1531
  },
  {
   "text": "このように",
   "at": 40.4404,
   "dur": 0.8175
  },
  {
   "text": "程よく短丈で",
   "at": 41.2579,
   "dur": 1.5515
  },
  {
   "text": "身幅は少しゆったりしている",
   "at": 42.8094,
   "dur": 1.9353
  },
  {
   "text": "ちょうどいいサイズ感の",
   "at": 44.7447,
   "dur": 1.7017
  },
  {
   "text": "Vネックニット",
   "at": 46.4464,
   "dur": 0.7007
  },
  {
   "text": "生地もチクチク感は控えめ",
   "at": 47.1471,
   "dur": 2.7695
  },
  {
   "text": "そして、Vネックの開き具合も",
   "at": 49.9166,
   "dur": 2.319
  },
  {
   "text": "浅めにしているから",
   "at": 52.2356,
   "dur": 1.3013
  },
  {
   "text": "肌の露出が苦手な人にもオススメできる",
   "at": 53.5369,
   "dur": 3.6535
  },
  {
   "text": "低身長でかつ顔がデカい人間は",
   "at": 57.1904,
   "dur": 2.5525
  },
  {
   "text": "Vネックを着ると首が長く見えて",
   "at": 59.7429,
   "dur": 3.4868
  },
  {
   "text": "小顔に見えやすいからオススメ",
   "at": 63.2297,
   "dur": 2.1856
  },
  {
   "text": "他には替えが効かない",
   "at": 65.4153,
   "dur": 2.1187
  },
  {
   "text": "Vネックニット",
   "at": 67.534,
   "dur": 1.1344
  },
  {
   "text": "チャコールとサンドトープを作りました",
   "at": 68.6684,
   "dur": 2.7527
  },
  {
   "text": "また、同じようなサイズ感で",
   "at": 71.4211,
   "dur": 1.7351
  },
  {
   "text": "ニットポロも作りました",
   "at": 73.1562,
   "dur": 1.8519
  },
  {
   "text": "ニットポロに関しては",
   "at": 75.0081,
   "dur": 1.6016
  },
  {
   "text": "コットンベースの生地なので",
   "at": 76.6097,
   "dur": 1.7017
  },
  {
   "text": "全くチクチクせずに",
   "at": 78.3114,
   "dur": 1.4014
  },
  {
   "text": "秋冬春と長い期間着ていただけます",
   "at": 79.7128,
   "dur": 3.6035
  },
  {
   "text": "トレンドのVネックか",
   "at": 83.3163,
   "dur": 1.4348
  },
  {
   "text": "定番のニットポロ",
   "at": 84.7511,
   "dur": 1.1511
  },
  {
   "text": "どちらも",
   "at": 85.9022,
   "dur": 0.8175
  },
  {
   "text": "低身長にしか似合わないサイズ感です",
   "at": 86.7197,
   "dur": 2.4525
  },
  {
   "text": "こちらの2型",
   "at": 89.1722,
   "dur": 1.1345
  },
  {
