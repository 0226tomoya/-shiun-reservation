  },
  {
   "text": "164cmでも",
   "at": 4.2042,
   "dur": 1.9353
  },
  {
   "text": "ほどよく短丈で",
   "at": 6.1395,
   "dur": 1.9853
  },
  {
   "text": "ちょうどいいサイズ感で着れる",
   "at": 8.1248,
   "dur": 2.052
  },
  {
   "text": "Vネックニットを作りました",
   "at": 10.1768,
   "dur": 1.9853
  },
  {
   "text": "僕たち低身長男性",
   "at": 12.1621,
   "dur": 1.8352
  },
  {
   "text": "一般的なニットだと",
   "at": 13.9973,
   "dur": 2.0354
  },
  {
   "text": "Sサイズでも",
   "at": 16.0327,
   "dur": 1.8184
  },
  {
   "text": "着丈が長すぎたり",
   "at": 17.8511,
   "dur": 1.9686
  },
  {
   "text": "逆に身幅が狭すぎたりと",
   "at": 19.8197,
   "dur": 3.3868
  },
  {
   "text": "ちょうどよく着れるニットって",
   "at": 23.2065,
   "dur": 2.1355
  },
  {
   "text": "なかなかないですよね",
   "at": 25.342,
   "dur": 1.7184
  },
  {
   "text": "サイズ感や色に妥協する",
   "at": 27.0604,
   "dur": 2.4191
  },
  {
   "text": "高いブランドも",
   "at": 29.4795,
   "dur": 1.5182
  },
  {
   "text": "プチプラのブランドも",
   "at": 30.9977,
   "dur": 1.685
  },
  {
   "text": "そもそも低身長男性を",
   "at": 32.6827,
   "dur": 2.6026
  },
  {
   "text": "ターゲットにしていないから",
   "at": 35.2853,
   "dur": 1.9519
  },
  {
   "text": "どれもサイズがデカすぎる",
   "at": 37.2372,
   "dur": 2.369
  },
  {
   "text": "そこで164cmの僕が着ても",
   "at": 39.6062,
   "dur": 3.5869
  },
  {
   "text": "このように",
   "at": 43.1931,
   "dur": 0.8341
  },
  {
   "text": "程よく短丈で",
   "at": 44.0272,
   "dur": 1.5515
  },
  {
   "text": "身幅は少しゆったりしている",
   "at": 45.5787,
   "dur": 2.0353
  },
  {
   "text": "ちょうどいいサイズ感の",
   "at": 47.614,
   "dur": 1.7351
  },
  {
   "text": "Vネックニット",
   "at": 49.3491,
   "dur": 0.8008
  },
  {
   "text": "生地もチクチク感は控えめ",
   "at": 50.1499,
   "dur": 2.7862
  },
  {
   "text": "そして、Vネックの開き具合も",
   "at": 52.9361,
   "dur": 2.3357
  },
  {
   "text": "浅めにしているから",
   "at": 55.2718,
   "dur": 1.3179
  },
  {
   "text": "肌の露出が苦手な人にもオススメできる",
   "at": 56.5897,
   "dur": 3.6869
  },
  {
   "text": "低身長でかつ顔がデカい人間は",
   "at": 60.2766,
   "dur": 2.9195
  },
  {
   "text": "Vネックを着ると首が長く見えて",
   "at": 63.1961,
   "dur": 3.8372
  },
  {
   "text": "小顔に見えやすいからオススメ",
   "at": 67.0333,
   "dur": 2.2189
  },
  {
   "text": "他には替えが効かない",
   "at": 69.2522,
   "dur": 2.1521
  },
  {
   "text": "Vネックニット",
   "at": 71.4043,
   "dur": 1.1845
  },
  {
   "text": "チャコールとサンドトープを作りました",
   "at": 72.5888,
   "dur": 3.1031
  },
  {
   "text": "また、同じようなサイズ感で",
   "at": 75.6919,
   "dur": 2.0354
  },
  {
   "text": "ニットポロも作りました",
   "at": 77.7273,
   "dur": 2.0355
  },
  {
   "text": "ニットポロに関しては",
   "at": 79.7628,
   "dur": 1.6516
  },
  {
   "text": "コットンベースの生地なので",
   "at": 81.4144,
   "dur": 1.7183
  },
  {
   "text": "全くチクチクせずに",
   "at": 83.1327,
   "dur": 1.4514
  },
  {
   "text": "秋冬春と長い期間着ていただけます",
   "at": 84.5841,
   "dur": 3.5535
  },
  {
   "text": "トレンドのVネックか",
   "at": 88.1376,
   "dur": 1.5182
  },
  {
   "text": "定番のニットポロ",
   "at": 89.6558,
   "dur": 1.2178
  },
  {
   "text": "どちらも",
   "at": 90.8736,
   "dur": 0.8175
  },
  {
